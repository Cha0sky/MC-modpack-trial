{
  "quest.4B61DD93ABC703EA.title": "在小屋里醒来",
  "quest.4B61DD93ABC703EA.quest_desc": [
    "【叙事占位：在小屋里醒来】",
    "开场剧情暂留占位，后续补写。",
    "这里有床、空箱和工作台。沿门廊出入聚落，屋外的空地可以继续扩建。",
    "成长剑已采用标准路线。先领取面包、火把和原木，安顿下来再出发；任务书中的物资需要手动领取。"
  ],
  "quest.36C3A881016E5E96.title": "第一趟矿洞",
  "quest.36C3A881016E5E96.quest_desc": [
    "【叙事占位：第一趟矿洞】",
    "在低于聚落地面至少 12 格的主世界矿层，用镐实际挖掘石头或矿石。",
    "带回 32 个圆石、8 个煤炭和 6 个粗铁。任务检测不会消耗这些材料。",
    "完成后领取一批石料、燃料和铁铜锭，用来做工具与起步设备；不用为了每个基础零件反复跑矿洞。"
  ],
  "quest.49639F9E7F91B628.title": "机械动力的起点",
  "quest.49639F9E7F91B628.quest_desc": [
    "【叙事占位：机械动力的起点】",
    "制作并保留至少 4 个安山合金，按 JEI 配方准备 Create 基础材料。"
  ],
  "quest.04E0645E6BC170B0.title": "为旅途建立后方",
  "quest.04E0645E6BC170B0.quest_desc": [
    "【叙事占位：为旅途建立后方】",
    "泥土生成器和机械动力的基础已经准备就绪。把小屋发展成自己的第一处基地。",
    "完成两条分支后，领取 1 个维度网络发生器和一批储物、建筑、远征物资，把家整理成可以随时出发的后方。"
  ],
  "quest.259C64DF4D981F3C.title": "通往猩红与腐化的道路",
  "quest.259C64DF4D981F3C.quest_desc": [
    "【叙事占位：通往猩红与腐化的道路】",
    "史莱姆王倒下后，整个世界的猩红与腐化区域解除进入限制，重新登录后仍保持开放。",
    "第一章“重启第一座工坊”已可接续：调查腐化或猩红、完成机械加工、制造调谐器并修复旧工坊。",
    "两种指南针是可自行补齐的探索工具；第一章从本节点接续，不要求先把两种指南针都做完。"
  ],
  "chapter.5A0FF97AED39E75E.title": "序章 · 从小屋出发",
  "quest.0464CA606F343573.title": "走出聚落",
  "quest.0464CA606F343573.quest_desc": [
    "【叙事占位：走出聚落】",
    "离开小屋，走到距离起点至少 96 格的地方，寻找树林、石头和矿洞。",
    "猩红与腐化区域已经生成，但在击败史莱姆王之前无法进入；不必在边界上反复尝试。"
  ],
  "quest.1991EA50DCDCE562.title": "准备下矿",
  "quest.1991EA50DCDCE562.quest_desc": [
    "【叙事占位：准备下矿】",
    "制作一把石镐。带上开局领取的食物与火把，再准备一些垫脚方块；多余物资可以先留在家里。"
  ],
  "quest.4500C181673A4FB3.title": "材料的另一种用法",
  "quest.4500C181673A4FB3.quest_desc": [
    "【叙事占位：材料的另一种用法】",
    "查看 JEI，制作泥土模板。当前无限之核使用材料直接合成模板，不需要空白模板。"
  ],
  "quest.2039A0EE2EAB186F.title": "第一个泥土生成器",
  "quest.2039A0EE2EAB186F.quest_desc": [
    "【叙事占位：第一个泥土生成器】",
    "亲手合成一个泥土生成器：8 个泥土模板围绕 1 块橡木木板。",
    "这一节点检测真实合成记录，单纯领取或捡到方块不算完成。",
    "领取泥土、木材和石材作为第一批扩建物资，生成器负责后续持续供应。"
  ],
  "quest.13DACF956E61E42F.title": "一套基础机械方块",
  "quest.13DACF956E61E42F.quest_desc": [
    "【叙事占位：一套基础机械方块】",
    "制作传动杆、齿轮、手摇曲柄和安山机壳各 1 个。先用手摇曲柄理解转动与传动。",
    "本次试作检测持有这些部件；自动化规模、动力指标与配方调整后续再展开。"
  ],
  "quest.441D1DEFF4C0B58E.title": "第一次首领挑战：史莱姆王",
  "quest.441D1DEFF4C0B58E.quest_desc": [
    "【叙事占位：第一次首领挑战：史莱姆王】",
    "在工作台合成史莱姆皇冠，准备装备与补给后召唤并击败史莱姆王。",
    "新增配方：8 个凝胶围绕 1 个金冠或铂金冠，产出 1 个史莱姆皇冠；皇冠本体沿用原生工作台配方。原祭坛配方保留。",
    "本章不改写汇流来世原生首领进度。",
    "史莱姆王击败记录按整个存档共享。普通史莱姆、首领仆从和取消的死亡不会打开区域。",
    "通关后领取保护Ⅱ、耐久Ⅱ铁胸甲，连同金苹果和经验瓶一起为边境调查做好准备。"
  ],
  "quest.4E2E6DEF9B35CC9D.title": "合成自然罗盘",
  "quest.4E2E6DEF9B35CC9D.quest_desc": [
    "【叙事占位：合成自然罗盘】",
    "击败史莱姆王后，按 JEI 的原生配方亲手合成 1 个自然罗盘。",
    "检测自然罗盘的首次制作配方；仅持有、拾取或修复已有罗盘不算。击败史莱姆王之前的合成不计入此节点。",
    "领取望远镜和拴绳，把沿途值得停留的地方与动物带进自己的生活。"
  ],
  "quest.280D401DA2351897.title": "合成探险者指南针",
  "quest.280D401DA2351897.quest_desc": [
    "【叙事占位：合成探险者指南针】",
    "击败史莱姆王后，按 JEI 的原生配方亲手合成 1 个探险者指南针。",
    "检测指南针的首次制作配方；仅持有、拾取或修复已有指南针不算。击败史莱姆王之前的合成不计入此节点。",
    "领取空地图与脚手架，为之后的遗迹测绘、攀爬和搭建准备工具。"
  ],
  "chapter.6BFCB3A5A742DFD0.title": "第一章 · 重启第一座工坊",
  "quest.69B3711BF25E107B.title": "旧工坊的委托",
  "quest.69B3711BF25E107B.quest_desc": [
    "一份残缺的维修记录提到了边境旧工坊：那里曾为附近的居民维修工具、制造零件。",
    "击败史莱姆王后，腐化与猩红已经可以进入。取得当地原木，尝试恢复记录中的复合材料工艺。",
    "采样与建设可以自由安排先后。自然罗盘帮助找群系，探险者指南针帮助找遗迹；不必重新完成已经做过的序章。",
    "这一章的核心是制造工具并亲手修复旧设施，五条支线均可自由选择，完成主线即可进入第二章。",
    "先领取熟牛排、火把和搭路石料。采样出发前检查工具、背包空位与回家的路线。"
  ],
  "quest.49A552499965E073.title": "越过边境",
  "quest.49A552499965E073.quest_desc": [
    "到腐化或猩红地区调查，准备共 4 个乌木原木或暗影原木。两种可以混合使用。",
    "乌木原木来自腐化树，暗影原木来自猩红树；不要求先挖黑檀石、猩红石或击败另一个首领。",
    "带在身上的样本会被记录，任务不会收走材料。之后把这 4 个原木送进磨石。"
  ],
  "quest.599B7AB467C23AF0.title": "让动力持续运转",
  "quest.599B7AB467C23AF0.quest_desc": [
    "让机械压机、磨石或搅拌器接上实际运转的动力，并走到设备旁累计观察约 10 秒。",
    "教学推荐小水车。压机与磨石可走 8 RPM 低速支路；搅拌器通过两级齿轮增速到 32 RPM。",
    "可采用其他动力方案。若系统过载，增加动力容量或分开运行设备；不需要把所有设备都加速。",
    "领取铁铜锭、红石和燃料，接下来由你亲自把原料加工成板材与共振胶。"
  ],
  "quest.6E074E85FED06EAC.title": "第一批精密零件",
  "quest.6E074E85FED06EAC.quest_desc": [
    "准备 7 个铁板和 2 个铜板：原生压机把 1 个金属锭压成 1 个对应板材。",
    "5 个铁板与 2 个安山合金先做搅拌头，再按 JEI 制作搅拌器和工作盆；另外 2 个铁板与 2 个铜板留给调谐器。",
    "取得的成果允许提前准备和同伴分工。先放进背包让成果记录，再投入后续工艺；已用于搅拌头和调谐器的板材也会计入。普通熔炉照常可以冶炼原料。",
    "领取工程师护目镜与安山合金，用护目镜观察设备的转速和应力，继续扩展你的工坊。"
  ],
  "quest.6B8E22D501AC0EA9.title": "异常材料的用途",
  "quest.6B8E22D501AC0EA9.quest_desc": [
    "将乌木原木或暗影原木放进磨石：每个原木稳定产出 2 份浸染纤维。",
    "共需 8 份纤维，4 个原木正好够用。可以放进背包记录，也可以直接送入自动混合；已经制成的共振胶会计入其消耗的纤维。"
  ],
  "quest.136EB0CDAD110108.title": "稳定的共振胶",
  "quest.136EB0CDAD110108.quest_desc": [
    "在工作盆内投入 2 份浸染纤维、1 份红石粉与 1 个黏液球或汇流凝胶，由机械搅拌器产出 1 份共振胶。",
    "本配方不加热、不需要液体管线，也不需要黄铜、烈焰人或下界材料。搅拌支路推荐 32 RPM。",
    "准备并记录 4 份共振胶：1 份用于制造调谐器，另外 3 份留给工坊三处设备。"
  ],
  "quest.228109ABBD3E71FA.title": "粗制调谐器",
  "quest.228109ABBD3E71FA.quest_desc": [
    "工作台组装：上排 铜板／玻璃／铜板；中排 铁板／共振胶／铁板；下排 空／传动杆／空。",
    "调谐器可以诊断古代设备的动力、方向和校准状态。它不消耗自身、不需要燃料；成功修复一处设备时消耗 1 份共振胶。",
    "在主世界手持调谐器对空气右键，领取指向废弃工坊的勘测地图；地图丢失后可再次操作补领，有短暂冷却。任务解锁顺序不影响已经取得的材料记录。",
    "领取扳手、水桶、3 台小水车、传动件和垫脚石料作为现场维修包。水车可给三处节点分别供能；出发前确认背包里还留有 3 份共振胶。"
  ],
  "quest.24BD52ACFB3E6BD0.title": "找到旧址",
  "quest.24BD52ACFB3E6BD0.quest_desc": [
    "沿工坊地图抵达旧址。在已有存档中请向未生成过的区块探索；更新后重用调谐器即可领取勘测图，探险者指南针也可以辅助寻找。",
    "正门、侧面、自己搭出的桥或挖出的通路都可以。先查看动力室、传动装置与屋顶信号装置。",
    "推荐带水车、水桶、传动杆、大小齿轮、扳手和 3 份共振胶，现场也可采用自己的传动方案。"
  ],
  "quest.7A22062328908A03.title": "三处故障",
  "quest.7A22062328908A03.quest_desc": [
    "手持调谐器对设备使用，阅读故障提示。三处节点都需要至少 8 RPM；方向节点还要求正向旋转，诊断会显示实际正负转速。",
    "动力接口是有圆孔或符号的彩色正面。把 Create 轴或齿轮放在正面相邻一格，轴向朝向设备，再接上动力。",
    "到达屋顶信号节点并恢复其条件。每处条件满足后，对设备长按右键约 3 秒完成校准，消耗 1 份共振胶。失败操作不扣材料。",
    "在同一座工坊内完成三处设备，修复状态由这个世界共享。"
  ],
  "quest.4FB59596BCAF8408.title": "工坊重新亮起",
  "quest.4FB59596BCAF8408.quest_desc": [
    "三处设备就绪后，使用中央控制台，让旧工坊重新启动。档案和章节成果在启动成功后开放。",
    "这里留下的工艺记录介绍普通工匠如何为周边居民服务，并指向机械、奥术与远征三类遗产。下一章将继续这些调查。",
    "这座工坊可以成为继续改造的野外据点。领取工程补给和效率Ⅲ、耐久Ⅱ钻石镐，带着新能力回家。",
    "第二章“遗产调查”会从这里接续。奖励中的 2 份共振胶可留给档案台，五条支线可以随时回来完成。"
  ],
  "quest.5B7CF06798316864.title": "支线 · 另一种异常",
  "quest.5B7CF06798316864.quest_desc": [
    "分别进入腐化与猩红，并让背包记录到乌木原木和暗影原木各 4 个。主线只要求任一路线，这里是自选的第二份调查。",
    "奖励两份备用共振胶、两件可放入展示框的区域标本纪念牌，以及木材与燃料补给。任务不收走你的原木。"
  ],
  "quest.0712DF7A63B058CE.title": "支线 · 从手作到量产",
  "quest.0712DF7A63B058CE.quest_desc": [
    "准备并记录 16 个铜板，已经用于调谐器的铜板也会计入。推荐尝试自动输入与收取，也允许手动完成。",
    "任务不收走铜板。奖励安山漏斗、传送带，再加安山隧道、漏斗、溜槽和一组传动杆，足够把几台机器真正连成一条线。"
  ],
  "quest.2AB221424C3AB34C.title": "支线 · 野外见闻录",
  "quest.2AB221424C3AB34C.quest_desc": [
    "在本章开启后走入三种不同的 Explorify 小型遗迹或营地。相同类型重复发现不会代替新的见闻。",
    "探索方向由你选择，不要求主线清空这些遗迹。已记录的发现会保留，之后回来交任务即可。",
    "领取铁砧、经验补给，以及力量Ⅲ、耐久Ⅱ弓和箭矢、熟食，为更远的冒险做准备。"
  ],
  "quest.1A2D41F3F0565916.title": "支线 · 第一次远征纪念",
  "quest.1A2D41F3F0565916.quest_desc": [
    "用拾光定影的相机记录自己的远征，完成胶片冲洗和打印，保存三张不同的照片。",
    "风景、同伴、遗迹或自己的工坊都可以，不对照片内容打分。自己拍摄的三张不同照片需要完成打印，复制同一张不会重复计数。",
    "领取展示框、横幅、书与笔和纸，把记录带回家，做成自己的照片墙或远征日志。"
  ],
  "quest.01646532D249D22F.title": "支线 · 沉睡的铁甲",
  "quest.01646532D249D22F.quest_desc": [
    "准备充分后，自愿挑战 Mowzie 的钢铁守护者。它位于地下的守护者室，是本章较难的技巧型支线。",
    "保留模组原生掉落。额外领取一枚纪念牌，并从耐久Ⅲ、效率Ⅲ、摔落保护Ⅲ附魔书中选择一本。另有钻石、金苹果和经验瓶作为挑战补给。",
    "这里的模组称号不代表它已经被设定为主线封印守护者；不完成此支线也能重启工坊。"
  ],
  "chapter.08D219867E4DF589.title": "第二章 · 遗产调查",
  "quest.1697E0EFFE71246B.title": "维修簿之外",
  "quest.1697E0EFFE71246B.quest_desc": [
    "旧工坊已经重新运转。维修簿中提到的工业设施、奥术记录与偏远遗址，现在可以分别展开调查。",
    "工程、奥术、远征三条路线同时开放，先后顺序由你选择。完成任意两条即可汇合；第三条保留为可选的继续探索。",
    "路线完成记录与发现的遗迹坐标由世界共享。材料与设备可以提前准备，也允许同伴协作。",
    "领取远征熟食、照明和脚手架再出发；三条路线分别提供工厂扩建、研究设施和探索装备奖励。"
  ],
  "quest.1C2F30D09583F848.title": "工程 · 让火进入工艺",
  "quest.1C2F30D09583F848.quest_desc": [
    "准备一个已经捕获烈焰人的燃烧室，以及至少 8 个黄铜锭。取得物品即可记录，允许同伴分工。",
    "空燃烧室由 4 铁板围绕 1 下界岩制作；在下界捕获烈焰人，带回后为其提供普通燃料。",
    "在加热工作盆中搅拌 1 铜锭与 1 锌锭，得到 2 黄铜锭。普通加热足够，不需要超级加热。",
    "本章原生进度采用持有记录；它不要求你丢弃队友送来的材料。领取锌铜、红石和石英后，可继续制作电子管和机械手。"
  ],
  "quest.2D5031EB24DB5DB1.title": "工程 · 可重复的精密工艺",
  "quest.2D5031EB24DB5DB1.quest_desc": [
    "实际运行一次机械手、完成一次注液器加工，并取得 1 个精密构件。三项可以分开完成，不要求一口气建成大型流水线。",
    "机械手由电子管、安山机壳和黄铜手制作。黄铜手需要 4 黄铜板与 1 安山合金；电子管由磨好的玫瑰石英与铁板制作，玫瑰石英需要 1 石英和 8 红石。",
    "注液器用于学习流体加工，例如向玻璃瓶注入 250 mB 蜂蜜。任意一次有效的注液器加工都可记录，精密构件则按下一条的原生工序装配。",
    "精密构件以金板起步，依次部署小齿轮、大齿轮和铁粒，重复 5 轮。原生成功率为 80%，请按 JEI 准备余量。",
    "机械手和注液器使用其原生运行进度，精密构件采用取得记录；已完成的原生进度可以被承认。"
  ],
  "quest.377BDBD8E94E1CD6.title": "整理工程记录",
  "quest.377BDBD8E94E1CD6.quest_desc": [
    "热工与精密加工的成果已经齐备，工程路线自动记入世界档案。不会收走设备或精密构件。",
    "领取机械臂、黄铜漏斗、传送带和铁板，把刚掌握的工艺扩展成实际的自动供料与加工线。原有黄铜和传动杆奖励也照常保留。",
    "把这份能力带回家园：继续扩展产线，或先去调查其他遗产，都由你决定。"
  ],
  "quest.7D0AC0F11F02C768.title": "奥术 · 选择研究方法",
  "quest.7D0AC0F11F02C768.quest_desc": [
    "奥术路线有两种完整的研究方法，选择其中一种继续即可，完成两种也只算一条奥术路线。",
    "铁魔法方法：准备铭文台和铁质法术书，将法术书实际装备到对应位置，为亲自施法做准备。",
    "诡厄方法：准备黑暗魔杖，按模组手册学习召唤僵尸仆从。",
    "两套方法保留各自的装备与操作方式，不要求先把另一套体系也做完。"
  ],
  "quest.00A2188434EF341F.title": "奥术 · 让知识发挥作用",
  "quest.00A2188434EF341F.quest_desc": [
    "沿你准备好的研究方法完成一次实际运用。",
    "铁魔法方法：实际装备铁质法术书后，从法术书释放一次法术。",
    "诡厄方法：用黑暗魔杖召唤僵尸仆从，再取得一次自己的仆从击败敌对生物的原生成就。",
    "基础和实践须完整满足同一体系。铁魔法与诡厄任一体系完成即可登记奥术记录。"
  ],
  "quest.271A129FAC02FC2C.title": "整理奥术记录",
  "quest.271A129FAC02FC2C.quest_desc": [
    "实际的奥术实践已经完成，研究记录自动加入世界档案。法术书、魔杖与其他装备由你保留。",
    "领取附魔台、16 个书架和研究耗材，在家里布置能长期使用的研究与附魔角。它不要求你补做另一套奥术方法。"
  ],
  "quest.3D8234164AB33DB0.title": "远征 · 走入两处遗产",
  "quest.3D8234164AB33DB0.quest_desc": [
    "调查以下四类遗迹中的任意两类：Mowzie 钢铁守护者室、汇流来世附魔剑冢、灾变沙漠遗址、灾变古代工厂。",
    "探险者指南针可使用结构 ID 搜索：mowziesmobs:wrought_chamber、confluence:enchanted_sword_shrine、cataclysm:desert_site、cataclysm:ancient_factory。",
    "走入结构范围即可留下调查记录和该类首个地点的坐标，不需要在调查时击杀遗迹中的 Boss。同一类型的不同地点只算一类。",
    "这些坐标稍后可以在遗产档案台中查询、制图。领取金苹果、熟食与箭矢，为下一次自选挑战补足后勤。"
  ],
  "quest.2A804883BB0B2318.title": "远征 · 一次自选挑战",
  "quest.2A804883BB0B2318.quest_desc": [
    "任选一位：钢铁守护者、霜冻巨兽、克苏鲁之眼、世界吞噬怪、克苏鲁之脑或诡厄巫法的骷髅领主。",
    "骷髅领主会在诡厄的大坟墓中开罐时出现。用探险者指南针搜 goety:crypt，带好补给再进墓。",
    "只记录首领本体。已完成的钢铁守护者支线和原生骷髅领主击败成就均可沿用。",
    "先调查再挑战、先挑战再旅行都可以；不要求把这些 Boss 逐个清完。原生掉落照常保留。"
  ],
  "quest.7FB7517299ACEB24.title": "整理远征记录",
  "quest.7FB7517299ACEB24.quest_desc": [
    "两类遗迹与一次自选挑战的记录已经齐备，远征路线自动加入世界档案。",
    "保留找到的装备与战利品。领取保护Ⅲ、摔落保护Ⅳ、耐久Ⅱ钻石靴，以及金胡萝卜和箭矢，继续选择自己的路线。"
  ],
  "quest.2892644A45456FAE.title": "让两条线索相遇",
  "quest.2892644A45456FAE.quest_desc": [
    "世界档案中已经有任意两条路线的完整记录，调查成果可以汇合。工程、奥术、远征三选二，第三条继续可选。",
    "接下来制作遗产档案台，把共同发现的地点和已经掌握的能力保存成可以带走的记录。",
    "档案台使用普通材料，不要求黄铜或精密构件；选择奥术与远征的玩家同样可以完成本章。",
    "领取成批石砖、平滑石和原木，为档案室、工厂或新的远征据点准备建筑材料。"
  ],
  "quest.760440CC9AACAC51.title": "建一处保存知识的地方",
  "quest.760440CC9AACAC51.quest_desc": [
    "制作并放置遗产档案台。工作台上排：书／玻璃／书；中排：铜板／安山机壳／铜板；下排：木板／共振胶／木板。",
    "可以放在自己的家、已修复的工坊或其他喜欢的位置。普通木板均可，档案台可以拆下搬走。",
    "制作它不收走任何路线装备，也不要求工程路线的黄铜与装配设备。"
  ],
  "quest.76FC61C7DB7BD176.title": "我们的遗产档案",
  "quest.76FC61C7DB7BD176.quest_desc": [
    "右键使用遗产档案台，取得或更新实体档案书，查看世界共享的三线进度与已经发现的遗迹地点。",
    "潜行右键切换已记录的地点；主手拿空地图右键，将所选地点绘制成地图。每类遗迹保存最先发现的位置。",
    "任意两条路线足以完成本章。领取物品保险库和效率Ⅳ、耐久Ⅲ钻石斧，连同展示与照明奖励一起，把调查成果安置进自己的基地。",
    "接下来可在第三章准备下界远征。再次使用档案台会更新遗迹位置和世界转折进度。"
  ],
  "quest.26D9E56E31143A19.title": "可选 · 完整的三路调查",
  "quest.26D9E56E31143A19.quest_desc": [
    "工程、奥术和远征全部留下完整记录。这个额外目标不影响两线汇合与主线完成。",
    "从 4 个物品保险库、4 个金苹果或 24 个经验瓶中选择一份纪念补给。",
    "另可领取经验修补附魔书、8 个钻石与 32 个经验瓶，作为完成全部调查的额外奖励。"
  ],
  "chapter.759CB26DEA732B94.title": "第三章 · 世界转折",
  "quest.2B08699FB66C78B4.title": "去往下界之前",
  "quest.2B08699FB66C78B4.quest_desc": [
    "从遗产档案继续远征，准备好装备、照明和可返回的下界通道。勾选后可以领取金胡萝卜、抗火药水和搭路石料。",
    "击败血肉首领会开启汇流来世的困难模式，随后部分主世界地形会发生变化。想先试打时，请使用备份存档。",
    "先分头勘察下界热源、在厨房备餐，再回工坊压封补给。勘察时带上粗制调谐器和至少 1 份共振胶。"
  ],
  "quest.6A44FF99927AF1BD.title": "击败血肉首领",
  "quest.6A44FF99927AF1BD.quest_desc": [
    "按向导巫毒玩偶的提示选择形态，再把玩偶投入下界岩浆。击败血肉墙或血肉山中的任意一位。",
    "任务读取汇流来世的世界通关记录，你可以和同伴一起打。过去已经完成的挑战也会计入。",
    "查看原生战利品并收好神锤，下一步可以用它显现新矿。"
  ],
  "quest.70B98B2219093652.title": "世界已进入困难模式",
  "quest.70B98B2219093652.quest_desc": [
    "当血肉首领的战果和困难模式状态都已记录，本节点会自动完成。",
    "世界可能还在分批转换地形。带着遗产档案书使用档案台，可以分别查看首领战果、困难模式状态和地形转换进度。",
    "准备神锤和采矿装备，就可以开始寻找新材料。"
  ],
  "quest.24BA016E81A9BDB9.title": "第一炉新矿",
  "quest.24BA016E81A9BDB9.quest_desc": [
    "把搅拌好的炉料和燃料送入地狱熔炉。一块炉料一次熔出 2 个对应金属锭。原生散矿配方仍可用，3 粗矿出 1 锭。",
    "把钴锭或钯金锭收进背包，下一章从重型工作台继续。已有原生战果和新锭的玩家可以使用原有物资补做前面的工序。",
    "把新材料带回基地，开始准备下一轮完整配装。可领取经验修补书、经验瓶和地狱砖。"
  ],
  "chapter.2D5047AC1452BE5B.title": "第四章 · 困难模式整备",
  "quest.6BEB2BDDDE4B91BF.title": "把新矿带上工作台",
  "quest.6BEB2BDDDE4B91BF.quest_desc": [
    "取得第三章的第一份新锭后，准备重型工作台。普通工作台中竖排放入工作台、铁砧或铅砧、工作台即可制作。",
    "拿到重型工作台或空手右键打开已放好的工作台，都能留下记录。",
    "接下来任选采掘或战斗路线。只有最后的下一阶锻造任务会涉及秘银或山铜。"
  ],
  "quest.5C52AA144E887000.title": "采掘 · 换上新工具",
  "quest.5C52AA144E887000.quest_desc": [
    "在重型工作台制作钴镐、钴钻头、钯金镐或钯金钻头。把其中一件拿在主手，稍等片刻即可记录。",
    "钴镐需要 15 个钴锭、3 根珍珠木棍；钴钻头用 12 个钴锭。钯金镐需要 18 个钯金锭、3 根珍珠木棍，钯金钻头用 18 个钯金锭。",
    "镐柄用的珍珠木棍可在重型工作台用 3 块珍珠木板制成 6 根。钻头路线可以直接使用金属锭。"
  ],
  "quest.60BCE50D3F42F766.title": "战斗 · 选一套合身的盔甲",
  "quest.60BCE50D3F42F766.quest_desc": [
    "在重型工作台制作钴或钯金护甲。穿上同一材质的头部、胸甲、护腿、靴子四件，稍等片刻即可登记。",
    "头部按流派选。钴可用头盔、钴帽或面具，钯金可用头盔、头饰或面具。一整套钴甲共 45 锭，钯金甲共 54 锭。",
    "按你原有的战斗习惯搭配成长剑、弓或法术。想继续使用其他护甲也可以走采掘路线。"
  ],
  "quest.7E82D9E88152A714.title": "把整备用起来",
  "quest.7E82D9E88152A714.quest_desc": [
    "任选一种实际行动。采掘路线在生存模式用上述镐或钻头挖一块有矿物掉落的矿石，例如铁矿。",
    "战斗路线穿齐上述任一套装，击败一只僵尸、尸壳、骷髅、流浪者、蜘蛛或掠夺者。可自由选择武器。",
    "完成一条路线即可领取扩建与远征补给。其他路线和下一阶锻造可以随后继续。"
  ],
  "quest.003111937F6E15CC.title": "选修 · 下一阶锻造",
  "quest.003111937F6E15CC.quest_desc": [
    "继续按原生祭坛线索寻找下一层矿物，准备秘银砧或山铜砧。取得或放置其中一座即可记录。",
    "重型工作台配方分别需要 10 个秘银锭或 12 个山铜锭，另加 3 块珍珠木板。查看 JEI 安排采集与熔炼。"
  ],
  "quest.65A8CA872474A532.title": "下界 · 从岩浆块取样",
  "quest.65A8CA872474A532.quest_desc": [
    "先去下界走一趟，选好传送门和返回路线。主手拿粗制调谐器，副手放共振胶，右键下界的岩浆块。",
    "1 份共振胶可采到 2 份热样胶，足够压封两餐。岩浆块保留，可以再次取样。"
  ],
  "quest.6CF98D5A1B67EC4C.title": "后方 · 备一锅饭",
  "quest.6CF98D5A1B67EC4C.quest_desc": [
    "在热源上架起农夫乐事的厨锅，任选蔬菜汤、鸡汤、炖牛肉或炒饭，盛碗后带到压机旁。",
    "炖牛肉可用生牛肉、胡萝卜和马铃薯；也可以按 JEI 用自家农产做蔬菜汤。取得其中一份即可记入，队友可以负责厨房。"
  ],
  "quest.01CBB2DD4D43F373.title": "工坊 · 压封行军餐",
  "quest.01CBB2DD4D43F373.quest_desc": [
    "在机械压机下方放工作盆。每次投入 1 份热样胶、1 张铜板和 1 份备好的料理，压出 1 份热封行军餐。可以手动投料，也可以用漏斗或传送带接入。",
    "将成品拿到背包里。吃一餐恢复 8 点饥饿值并获得 90 秒抗火，饱食时也能使用。另一份热样胶可以留给下次远征。"
  ],
  "quest.4949B108C7E78A72.title": "回程 · 给地狱熔炉配料",
  "quest.4949B108C7E78A72.quest_desc": [
    "拿神锤敲祭坛显现新矿，带回 6 份粗钴或 6 份粗钯金。在基地把这批矿交给机械搅拌器与工作盆。",
    "6 份同种粗矿一次混成 1 块对应炉料，无需加热或注液。首批先拿到背包里登记，再送进地狱熔炉；以后可以直接连续供料。"
  ],
  "chapter.3ABD0124FB8AEDA1.title": "第五章 · 遗址远征",
  "quest.2A5C04757DCBFF09.title": "工坊配给 · 整装出发",
  "quest.2A5C04757DCBFF09.quest_desc": [
    "完成第四章的实地检验后，从工坊带上两份热封行军餐。热样胶、铜板和厨锅料理在压机下的工作盆里装成一份餐。",
    "领取空地图和照明，选择地下墓穴或林地府邸。只勘察一个地点并把地图带回家，也能完成本章。"
  ],
  "quest.4E12304BAD37FF5B.title": "墓穴线 · 找到地下墓穴",
  "quest.4E12304BAD37FF5B.quest_desc": [
    "铁魔法的归途指南针可以寻找地下墓穴，也可用探险者指南针搜索 irons_spellbooks:catacombs。",
    "进入结构范围稍作停留，世界档案会记下此类遗迹的首个坐标。可以先撤出制图，日后再进深处挑战。"
  ],
  "quest.646D06C50CFE205B.title": "府邸线 · 查明林地据点",
  "quest.646D06C50CFE205B.quest_desc": [
    "用林地探险家地图，或用探险者指南针搜索 minecraft:mansion，进入原版林地府邸的建筑范围并稍作停留。",
    "府邸地点会写入档案，空手调查即可。要邀战灾厄宰相，再准备诡厄的黑暗卷轴。"
  ],
  "quest.33B054D584DD1602.title": "交回远征地图",
  "quest.33B054D584DD1602.quest_desc": [
    "任意一条勘察线完成后，返回遗产档案台。空手潜行右键选中地下墓穴或林地府邸，再主手持空地图、松开潜行右键制图。",
    "一张空地图换一张带有目标标记与坐标的地图。这份地图可以交给队友，也可以留给下一次讨伐使用。"
  ],
  "quest.3E5955E508399D8A.title": "自选讨伐 · 死者之王",
  "quest.3E5955E508399D8A.quest_desc": [
    "回到地下墓穴深处，与沉睡的遗骸互动可唤醒死者之王。先找到退路，再决定是否开战。",
    "击败现身的死者之王本体。原生掉落照常取得。曾有玩家击杀统计的旧战果同样可以登记。"
  ],
  "quest.093F5AD1EFBF4A19.title": "自选讨伐 · 灾厄宰相",
  "quest.093F5AD1EFBF4A19.quest_desc": [
    "在工作台上竖排放黑色染料、魔法布料和不死图腾，制作诡厄的黑暗卷轴。在林地府邸内长按使用卷轴召唤宰相。",
    "留意剑击、尖刺与怒鬼。击败宰相本体即可完成，分身不计。诡厄原生的亲自击败或仆从击败成就都可接续。"
  ]
}
