  ],
  "quest.207DCFA8CC08E010.quest_subtitle": "0 点护甲 · 头部",
  "quest.1AAFDF234E93FFD2.title": "夏日草帽",
  "quest.1AAFDF234E93FFD2.quest_desc": [
    "0 点护甲 · 头部",
