{
  "chapter.222BBD789A0294E6.title": "安家与启程",
  "quest.3BB9F666F8AC561A.title": "把远征的起点变成家",
  "quest.3BB9F666F8AC561A.quest_desc": [
    "这是一条推荐路线：你可以提前探索、获取装备，也可以先留下来建设。主线不会限制你的自由。先打开 JEI 查看配方，读完后手动勾选。基地保护来自实际放置的庇护石，勾选任务不会自动保护住所。"
  ],
  "quest.3D516D8E38B87265.title": "第一张工作台",
  "quest.3D516D8E38B87265.quest_desc": [
    "选址时留出工厂、农田与女仆居所的位置。获得一张工作台；物品检测任务不消耗材料。已经建造的方块可拿回背包完成检测，然后重新放置。"
  ],
  "quest.108F2B3F11406CA7.title": "可以停留的住所",
  "quest.108F2B3F11406CA7.quest_desc": [
    "建一个有屋顶、照明和出入口的临时住所，并放置任意颜色的床。建筑形状由你决定，完成后手动勾选。屋顶、床和火把不能替代后续的完整安全区机制。"
  ],
  "quest.3B162C83F0DADE21.title": "给夜晚一点光",
  "quest.3B162C83F0DADE21.quest_desc": [
    "准备 16 支火把，照亮居所与附近道路。火把只负责普通照明；不能承诺阻挡外来敌人或特殊袭击。留意地下空洞。"
  ],
  "quest.40E70867BC58711E.title": "从此安心建设",
  "quest.40E70867BC58711E.quest_desc": [
    "用四块玻璃、四个铜锭和一支火把合成庇护石，放在基地。默认覆盖水平半径48格内的全部高度，放置启用、拆除解除，多块可重叠扩建。右键查看范围；玩家和伙伴在区内获得伤害保护，敌对生物进入会被移除而不会产生掉落或成长收益。刷怪场、Boss召唤与练习场放在保护区外。物品检测只确认你取得庇护石，仍需亲自放置。"
  ],
  "quest.5A0EBE8659545B73.title": "东西各有归处",
  "quest.5A0EBE8659545B73.quest_desc": [
    "准备两个箱子，至少将建筑材料与远征装备分开。给未来的加工线预留输入和输出箱位置。无需为了这个任务整理到完美。"
  ],
  "quest.12530451F7152650.title": "稳定的第一炉",
  "quest.12530451F7152650.quest_desc": [
    "先有稳定的燃料和熔炼位置，再考虑更高产能。制作一个熔炉；原矿、燃料和产物尽量放在附近。"
  ],
  "quest.7BFE58E55ADC6585.title": "一小片农田",
  "quest.7BFE58E55ADC6585.quest_desc": [
    "种植一种你容易找到的作物，设置水源与补种空间。不要为了任务寻找指定稀有作物；能连续收获才是目标。完成后手动勾选。"
  ],
  "quest.602AAABBC7D431EF.title": "随时能够出发",
  "quest.602AAABBC7D431EF.quest_desc": [
    "准备 8 个面包作为最初的应急补给。后续厨房与女仆可以丰富食谱；现在先避免每次准备远征都重新找食物。"
  ],
  "quest.18553CBD965B4F53.title": "给失误留余地",
  "quest.18553CBD965B4F53.quest_desc": [
    "准备盾牌，并在普通敌人面前练习防御和退路。并非所有模组攻击都能格挡，遇到陌生技能先观察。"
  ],
  "quest.20FB17D6DCADD430.title": "认识自己的成长",
  "quest.20FB17D6DCADD430.quest_desc": [
    "打开 RPG 成长界面，阅读生命、攻击、防御和其他属性。选择适合当前玩法的加点方向；不要为了练级放弃建设和探索。此任务只确认你已阅读与操作，手动勾选，不会赠送技能点。"
  ],
  "quest.4D80FD02288C68F7.title": "一把与你一起成长的剑",
  "quest.4D80FD02288C68F7.quest_desc": [
    "噬星之刃有个人成长记录，模式选择会影响成长门槛。先阅读界面说明再确认，当前模组选择通常永久锁定。已有赠剑可直接完成检测，不要求重复合成。"
  ],
  "quest.594BFE2D5C8003A1.title": "第一次短途远行",
  "quest.594BFE2D5C8003A1.quest_desc": [
    "带好食物、照明和返程路线，进行一次你愿意承担的短途探索。找一处地形、资源或遗迹，安全返回即可。这里没有自动击杀或探索检测，返回后手动记录；不要求挑战 Boss。"
  ],
  "quest.14A24CFDE4D1C806.title": "认识未来的伙伴",
  "quest.14A24CFDE4D1C806.quest_desc": [
    "制作博丽的御币，并通过女仆模组的说明和 JEI 了解祭坛与召唤。不要用危险环境催促养成；先给伙伴准备住所，再安排工作。"
  ],
  "quest.7EBEC79952D16314.title": "为女仆留一个位置",
  "quest.7EBEC79952D16314.quest_desc": [
    "准备女仆的活动空间、存放物品的位置和休息区域，了解跟随、工作及待机的切换方式。召唤或招募首位女仆后，先熟悉界面。此阶段以实际安置体验为目标，完成后手动勾选。"
  ],
  "quest.35F79A5C6C9E8F60.title": "第一处喜欢的风景",
  "quest.35F79A5C6C9E8F60.quest_desc": [
    "做一条小路、花坛、观景台或窗边角落。选你喜欢的材料，不按固定模板建造。风景建设也是进度的一部分，完成后手动勾选。"
  ],
  "quest.363511E10862A9B0.title": "从食物到生活",
  "quest.363511E10862A9B0.quest_desc": [
    "制作农夫乐事厨锅，按它的加热要求摆放。先学会一种能稳定获得原料的料理；后续再把厨房、农田和女仆工作串起来。"
  ],
  "chapter.1A79192E96D02164.title": "转动的生活",
  "quest.49357C37B476AD91.title": "机械动力的起点",
  "quest.49357C37B476AD91.quest_desc": [
    "准备 8 个安山合金，查看 JEI 中现有配方。它是许多初级动力部件的起点；先做一条小型有效生产线，再扩建厂房。"
  ],
  "quest.252C541353825117.title": "让水流转动起来",
  "quest.252C541353825117.quest_desc": [
    "制作水车并按机械动力的思索演示布置水流。取得物品即可完成检测；放置后的转动与应力是否正常，需要你实际观察。"
  ],
  "quest.05D0B2F88EFB14B9.title": "把动力送到需要的地方",
  "quest.05D0B2F88EFB14B9.quest_desc": [
    "准备传动杆，规划从水车到机器的路线。短而清晰的线路更容易维护；注意转速、方向和应力。"
  ],
  "quest.7CE162BDD28821F7.title": "改变方向与速度",
  "quest.7CE162BDD28821F7.quest_desc": [
    "使用齿轮让动力转向，尝试大小齿轮配合。先查看思索演示，避免只复制结构却不知道为什么转动。"
  ],
  "quest.3D8944EECD92CBA5.title": "第一道加工",
  "quest.3D8944EECD92CBA5.quest_desc": [
    "制作动力冲压机，接入动力。为它准备合适的工作平台与输入材料；不要把取得机器当作完成整条自动化。"
  ],
  "quest.7521B436FA5DF77E.title": "给加工一个工作面",
  "quest.7521B436FA5DF77E.quest_desc": [
    "制作置物台，用于初期冲压等加工。布局时留下观察机器工作和取回产物的空间。"
  ],
  "quest.339FED95428ECFD9.title": "看见加工的结果",
  "quest.339FED95428ECFD9.quest_desc": [
    "获得 4 个铁板，体验一次从材料到产物的转换。取得物品会自动检测；若由探索等其他途径得到，也允许完成。推荐你仍亲自尝试冲压流程。"
  ],
  "quest.582A53F81B3A210C.title": "读懂工厂的状态",
  "quest.582A53F81B3A210C.quest_desc": [
    "工程师护目镜能帮助查看机器信息。把观察转速、应力和吞吐量变成习惯，会比盲目增加机器更省力。"
  ],
  "quest.75D2738E4A7487B4.title": "把重复采集交给机器",
  "quest.75D2738E4A7487B4.quest_desc": [
    "制作石头生成器。无限之核负责减轻重复采集；机械动力继续负责加工、物流与工程。请通过 JEI 核对对应模板和当前配方，生成器本身不会在任务完成时自动工作。"
  ],
  "quest.6AB80ED74AF21F6A.title": "模板决定产物",
  "quest.6AB80ED74AF21F6A.quest_desc": [
    "制作或取得石头生成模板，按照无限之核界面说明放入兼容的生成器。模板的实际可选产物和速度以模组运行表现为准；先确认输入模板后确实开始生产。"
  ],
  "quest.68A39D988F774347.title": "产物不必一直手动拿",
  "quest.68A39D988F774347.quest_desc": [
    "准备漏斗，试着连接生成器或工厂的输出和储物箱。具体输出面与容器支持需实际操作确认；先保证小系统工作再复制扩建。"
  ],
  "quest.4A3AF0C6CE2DECFE.title": "一条真正有用的小循环",
  "quest.4A3AF0C6CE2DECFE.quest_desc": [
    "完成一个能持续使用的小系统：稳定原材料来源、加工或整理环节、储物输出。可以包含无限之核，也可以先用其他来源。运行一段时间，检查卡料与满箱问题后手动勾选。"
  ],
  "quest.042E5FEA3C341FFC.title": "伙伴与工厂各有所长",
  "quest.042E5FEA3C341FFC.quest_desc": [
    "为女仆安排一项适合当前装备和任务能力的工作，并检查收集范围、存放位置与补给。不要预设所有自动化都能由女仆完成；先实现一项清楚、稳定的分工。完成后手动勾选。"
  ],
  "quest.1A4809762024D8FB.title": "下一次远征，由你选择",
  "quest.1A4809762024D8FB.quest_desc": [
    "整理补给与装备，选择下一次探索方向：魔法、汇流世界、遗迹或 Boss 线索都可以。先把想完成的目标写下来；基地发展和冒险可以交替进行，不必等这一章全清才出发。手动勾选仅记录你的计划。"
  ],
  "chapter.5F8B6A6CF08EEBA1.title": "魔法与远征准备",
  "quest.002CA61C8686BEB8.title": "从一本日志开始",
  "quest.002CA61C8686BEB8.quest_desc": [
    "铜制的初学者日志是认识铁魔法法术书的一条入门路线。阅读 JEI 配方，获得后放入对应装备槽，熟悉法术选择界面。你也可以使用探索得到的其他法术书；本任务只是推荐物品路线。"
  ],
  "quest.627864CB136ECB90.title": "法术的材料",
  "quest.627864CB136ECB90.quest_desc": [
    "准备奥术精华，查看它在法术书和其他配方中的用途。为魔法材料设一个独立储物区，先记录稳定获取方式，再决定是否建设专用供应线。"
  ],
  "quest.3EDB48778C9AF28E.title": "把知识写入卷轴",
  "quest.3EDB48778C9AF28E.quest_desc": [
    "取得普通墨水，认识法术等级与制作材料的关系。探索所得的高级法术同样允许使用，不必等待任务章节。"
  ],
  "quest.4E160AF5A8ACEA84.title": "专门的抄写空间",
  "quest.4E160AF5A8ACEA84.quest_desc": [
    "准备誊写桌，并查看铁魔法关于卷轴、法术书和誊写操作的说明。把魔法工作区放在补给储物旁边，方便往返。"
  ],
  "quest.68CA328F68C5C94E.title": "先学会一次稳定施法",
  "quest.68CA328F68C5C94E.quest_desc": [
    "在空旷位置练习选择法术、施法和等待冷却，观察法力消耗。与近战装备搭配，找出能稳定使用的一种法术。任务由你手动确认，不会读取或改写法术等级。"
  ],
  "quest.65FE2886F26F06F4.title": "一个方向，几个实用法术",
  "quest.65FE2886F26F06F4.quest_desc": [
    "选一个你喜欢的流派，为它准备常用法术组合：攻击、移动或恢复至少有明确用途。可以随后更换方向，不要求集齐全部流派才继续探索。完成后手动记录。"
  ],
  "quest.38CC46F292A4F403.title": "另一种魔法道路",
  "quest.38CC46F292A4F403.quest_desc": [
    "取得诡厄的黑暗之书，按书中条目了解祭坛、聚晶与灵魂资源。诡厄路线可以和铁魔法并行；先弄清召唤物与材料的规则，再尝试复杂仪式。"
  ],
  "quest.14098669ABF49350.title": "灵魂也需要存储",
  "quest.14098669ABF49350.quest_desc": [
    "准备灵魂图腾，阅读如何存储和使用灵魂能量。诡厄可能带来追猎等事件；基地放置庇护石，主动战斗、敌对召唤和刷怪仪式安排在保护区外，避免目标刚生成就被庇护机制移除。"
  ],
  "quest.5C2E0E480D48FC5A.title": "让聚晶找到载体",
  "quest.5C2E0E480D48FC5A.quest_desc": [
    "准备黑暗魔杖，按黑暗之书了解聚晶如何装配与施法。先在远离伙伴的位置尝试，弄清范围和目标规则。"
  ],
  "quest.4DB53126DC8BC315.title": "伙伴与召唤物的边界",
  "quest.4DB53126DC8BC315.quest_desc": [
    "尝试一种召唤或控制能力，确认目标、持续时间和跟随方式。不要默认所有召唤物都能与女仆或所有魔法友好配合；先明确自己准备带谁远行。由你手动确认。"
  ],
  "quest.71F3C61DE6FAB052.title": "从汇流的风景读世界",
  "quest.71F3C61DE6FAB052.quest_desc": [
    "找一处汇流相关地形、结构或资源，查看它关联的装备与探索内容。当前包中的 Boss、事件及生成规则以已安装版本为准，不套用其他版本的固定攻略。探索后手动记录。"
  ],
  "quest.6ACF3211236B8975.title": "远征之前的补给台",
  "quest.6ACF3211236B8975.quest_desc": [
    "建一处酿造与补给位置。为计划挑战准备有用途的药水和备用材料，而不是为了任务制作所有药水。"
  ],
  "quest.097C16EA8BF94AE0.title": "失败后还能再出发",
  "quest.097C16EA8BF94AE0.quest_desc": [
    "准备一份备用食物、照明和基础装备，确认从住所到上次探索地点的路线。不要在装备全损后才考虑恢复方案。死亡惩罚尚未额外调整，此任务由你确认准备情况。"
  ],
  "quest.07AA1521CD414709.title": "选择一次真正的远征",
  "quest.07AA1521CD414709.quest_desc": [
    "为这次远征写下一个明确目标：一种材料、一处遗迹或一个 Boss 线索。把需要的材料带齐，决定何时返程。可以先做基地工程，也可以直接出发；完成准备后手动勾选。"
  ],
  "chapter.0790605E241C44F4.title": "挑战与收获",
  "quest.6E611FB45396E37F.title": "先把战场看清",
  "quest.6E611FB45396E37F.quest_desc": [
    "进入陌生结构时先找到落脚点和撤退路线。观察范围攻击、地形与补给空间；将正式挑战场与主要基地分开。此任务记录你的准备，由你手动确认。"
  ],
  "quest.08D96F8A71700D89.title": "末地远征",
  "quest.08D96F8A71700D89.quest_desc": [
    "挑战末影龙。任务采用 FTB 的击杀计数，取得龙蛋等物品不等于完成击杀任务；历史击杀不会由本任务自动补记。提前挑战同样允许。"
  ],
  "quest.3E87FFDEDC429CD7.title": "凋灵试炼",
  "quest.3E87FFDEDC429CD7.quest_desc": [
    "在与基地隔离的场地召唤并挑战凋灵。提前准备退路与补给；不要用主厂房测试凋灵是否会破坏方块。任务检查有效击杀计数。"
  ],
  "quest.3D98D41F71C588BF.title": "守卫者的遗迹",
  "quest.3D98D41F71C588BF.quest_desc": [
    "寻找并挑战灾变的末影守卫者。先阅读结构线索并观察招式，再选择近战、法术或其他装备路线。这里不是强制 Boss 排名，允许你按照自己的发现顺序挑战。"
  ],
  "quest.522FA7BC7BFE32E7.title": "下界中的巨物",
  "quest.522FA7BC7BFE32E7.quest_desc": [
    "挑战下界合金巨兽。针对具体 Boss 准备装备和补给，避免仅根据伤害数字判断能否取胜。任务使用击杀检测。"
  ],
  "quest.3B876D46CCB31D30.title": "机械遗迹的回响",
  "quest.3B876D46CCB31D30.quest_desc": [
    "探索并挑战先驱者，留意它的距离、阶段和场地变化。先做侦察再决定正式挑战时机；不要求上一条 Boss 任务先完成。"
  ],
  "quest.12C522058E62BFC7.title": "深水远征",
  "quest.12C522058E62BFC7.quest_desc": [
    "挑战利维坦前准备水下呼吸、移动与视野。Boss 的活动环境会影响机制，不要把水下战斗直接当作陆地战斗。任务采用有效击杀计数。"
  ],
  "quest.6737555EF25FDB7D.title": "与焰色的剑交锋",
  "quest.6737555EF25FDB7D.quest_desc": [
    "按已安装版本的召唤规则挑战焰魔。观察招式与阶段，保留补给和撤退空间。可以提前取得装备，主线不会阻止你尝试。"
  ],
  "quest.28C348ABF6756CE8.title": "让收获有一个位置",
  "quest.28C348ABF6756CE8.quest_desc": [
    "在基地设置战利品陈列处。为一次远征留一块标牌、一个展示台或一张截图；展示什么由你决定。它是建设与旅行的连接，不要求消耗稀有掉落。"
  ],
  "quest.4C9E496F552D0930.title": "把旅行带回工厂",
  "quest.4C9E496F552D0930.quest_desc": [
    "准备黄铜机壳，推进中阶生产。工程合成路线可以用机械动力部件和较少模板制作无限之核生成器；原路线也继续保留。查看 JEI 对比你当前更容易承担的材料成本。"
  ],
  "quest.51F06E59A2203B65.title": "精密机制与资源核心",
  "quest.51F06E59A2203B65.quest_desc": [
    "准备精密构件，查看铜、铁、金及更高阶无限之核生成器的工程配方。精密构件仍要通过实际生产流程取得，不由任务奖励直接赠送。"
  ],
  "quest.6583BF6E4ABDF834.title": "下一步不必还是战斗",
  "quest.6583BF6E4ABDF834.quest_desc": [
    "回到基地后选一个目标：补上生产缺口、改善居所、培养女仆或准备新的挑战。主线支持交替推进，不要求一直向更高难度战斗奔跑。由你手动记录下一步。"
  ],
  "chapter.2D5FDDD6C5503CF0.title": "家园与伙伴",
  "quest.5E8668CD602009E1.title": "她也有自己的居所",
  "quest.5E8668CD602009E1.quest_desc": [
    "为女仆准备女仆床与独立空间，了解休息行为及相关设置。把工作区和居所清楚地区分开；养成可以和主线同步推进。"
  ],
  "quest.022B9F7384AF4B61.title": "轻装开始工作",
  "quest.022B9F7384AF4B61.quest_desc": [
    "准备小背包，确认女仆可携带的物品和工作所需工具。先把一个简单工作流程安排清楚，再考虑扩大规模。"
  ],
  "quest.00E7C5C0FAED12FC.title": "空间跟着生活成长",
  "quest.00E7C5C0FAED12FC.quest_desc": [
    "准备中背包。升级的价值来自实际需要：采集更多、远行更久或分类更清楚；不要求每个伙伴都立即升级。"
  ],
  "quest.6F95EBCAEC9032A5.title": "她的样子，由你挑选",
  "quest.6F95EBCAEC9032A5.quest_desc": [
    "在现有女仆模型与服装设置中选择喜欢的外观，熟悉更换方式。优先使用实例已有且兼容的内容，不为完成任务必须下载额外模型。由你手动确认。"
  ],
  "quest.5BB56B6E3E536129.title": "相处比刷数值更重要",
  "quest.5BB56B6E3E536129.quest_desc": [
    "查看女仆爱恋附属的互动界面，了解喜欢的互动、限制与反馈。选一种你愿意日常进行的方式；本任务不设高好感度数值门槛，也不声称自动检测好感度。"
  ],
  "quest.0B175B1A183ED159.title": "餐厅开张的准备",
  "quest.0B175B1A183ED159.quest_desc": [
    "取得餐厅菜单，按女仆餐厅的玩法说明规划服务区域、食物供应与工作分配。先从少量菜品开始，保证供应再扩展。"
  ],
  "quest.4344140618BC2E0E.title": "厨房有自己的秩序",
  "quest.4344140618BC2E0E.quest_desc": [
    "准备两个橡木橱柜，体验厨房储物。若更喜欢其他材质，可直接建设；本任务的物品检测只针对橡木版本，不限制你实际使用的风格。"
  ],
  "quest.1EA842CC7BFCCB89.title": "一份稳定的日常菜单",
  "quest.1EA842CC7BFCCB89.quest_desc": [
    "确定几种能稳定获得原料的食物，安排种植、加工与存放。让厨房供应来自农田与日常生产；先做到不用每次临时补原料。完成后手动勾选。"
  ],
  "quest.79C6B184C0DE7B10.title": "留住一段日常",
  "quest.79C6B184C0DE7B10.quest_desc": [
    "制作文文的相机，了解现有版本的拍摄和相关物品玩法。也可以用游戏截图记录基地变化；取得相机自动检测，不代表已经拍摄。"
  ],
  "quest.78FB12DB1A49C0FB.title": "让工厂融入风景",
  "quest.78FB12DB1A49C0FB.quest_desc": [
    "选一个工厂外观问题来改善：管线整理、绿化、窗户、道路或水景。审美没有标准答案，做成你喜欢的样子即可，完成后手动勾选。"
  ],
  "quest.0A5D70F8725E5B7D.title": "一个可以什么也不做的角落",
  "quest.0A5D70F8725E5B7D.quest_desc": [
    "建一处休息角落，能够看见喜欢的景色。这个任务没有产能或装备要求；你愿意坐下来停留就是它的用途。手动记录建设完成。"
  ],
  "quest.4F7DA81AE9C30258.title": "伙伴们的分工",
  "quest.4F7DA81AE9C30258.quest_desc": [
    "若你已有多位女仆，安排互不冲突的工作与居所；若只养成一位，也可整理她的工具、补给和活动范围。人数不是进度门槛，完成后手动确认。"
  ],
  "quest.6BC606D5A5219EF2.title": "给家一个长期工程",
  "quest.6BC606D5A5219EF2.quest_desc": [
    "为家园选择一个长期项目，例如庭院、餐厅、车站或观景楼。分出能在几次游玩中完成的小步骤，并准备主要材料来源。任务记录计划，不将自选工程自动判定为完工。"
  ],
  "quest.12168CA123939797.title": "旅行之后仍愿意回来",
  "quest.12168CA123939797.quest_desc": [
    "完成一次出行后回到自己建设的家，整理收获并看看伙伴。可以继续冒险，也可以把下一段时间留给生活。手动记录你当前最喜欢的家园部分。"
  ],
  "chapter.DA0FF97AED39E75E.title": "第一章 · 从小屋出发",
  "quest.4B61DD93ABC703EA.title": "在小屋里醒来",
  "quest.4B61DD93ABC703EA.quest_desc": [
    "村民发现你时，你身边只有一把剑。你在他们为你留出的屋子里醒来。",
    "这里有床、空箱和工作台，屋外的空地可以继续扩建。铁门两侧有按钮。",
    "成长剑已采用标准路线。先安顿下来，再踏上旅途。前言物资与完整玩法介绍将在后续制作。"
  ],
  "quest.8464CA606F343573.title": "走出聚落",
  "quest.8464CA606F343573.quest_desc": [
    "离开小屋，走到距离起点至少 96 格的地方，寻找树林、石头和矿洞。",
    "猩红与腐化区域已经生成，但在击败史莱姆王之前无法进入；不必在边界上反复尝试。"
  ],
  "quest.9991EA50DCDCE562.title": "准备下矿",
  "quest.9991EA50DCDCE562.quest_desc": [
    "制作一把石镐。食物、照明和其他工具由你自行准备；本次试作暂不额外赠送。"
  ],
  "quest.36C3A881016E5E96.title": "第一趟矿洞",
  "quest.36C3A881016E5E96.quest_desc": [
    "在低于聚落地面至少 12 格的主世界矿层，用镐实际挖掘石头或矿石。",
    "带回 32 个圆石、8 个煤炭和 6 个粗铁。任务检测不会消耗这些材料。"
  ],
  "quest.C500C181673A4FB3.title": "材料的另一种用法",
  "quest.C500C181673A4FB3.quest_desc": [
    "查看 JEI，制作泥土模板。当前无限之核使用材料直接合成模板，不需要空白模板。"
  ],
  "quest.A039A0EE2EAB186F.title": "第一个泥土生成器",
  "quest.A039A0EE2EAB186F.quest_desc": [
    "亲手合成一个泥土生成器：8 个泥土模板围绕 1 块橡木木板。",
    "这一节点检测真实合成记录，单纯领取或捡到方块不算完成。"
  ],
  "quest.49639F9E7F91B628.title": "机械动力的起点",
  "quest.49639F9E7F91B628.quest_desc": [
    "制作并保留至少 4 个安山合金，按 JEI 配方准备 Create 基础材料。"
  ],
  "quest.93DACF956E61E42F.title": "一套基础机械方块",
  "quest.93DACF956E61E42F.quest_desc": [
    "制作传动杆、齿轮、手摇曲柄和安山机壳各 1 个。先用手摇曲柄理解转动与传动。",
    "本次试作检测持有这些部件；自动化规模、动力指标与配方调整后续再展开。"
  ],
  "quest.04E0645E6BC170B0.title": "为旅途建立后方",
  "quest.04E0645E6BC170B0.quest_desc": [
    "泥土生成器和机械动力的基础已经准备就绪。把小屋发展成自己的第一处基地。",
    "完成两条分支后，领取 1 个维度网络发生器。它是本次试作唯一新增的物品奖励。"
  ],
  "quest.C41D1DEFF4C0B58E.title": "第一次首领挑战：史莱姆王",
  "quest.C41D1DEFF4C0B58E.quest_desc": [
    "做好装备与补给，按汇流来世的原生方式召唤并击败史莱姆王。",
    "召唤条件以当前模组实际玩法与 JEI 为准。本章不改写汇流来世原生首领进度。",
    "史莱姆王击败记录按整个存档共享。普通史莱姆、首领仆从和取消的死亡不会打开区域。"
  ],
  "quest.259C64DF4D981F3C.title": "通往猩红与腐化的道路",
  "quest.259C64DF4D981F3C.quest_desc": [
    "史莱姆王倒下后，整个世界的猩红与腐化区域解除进入限制，重新登录后仍保持开放。",
    "第一章试作到这里结束。第二章的探索目标、敌人和进一步发展路线尚未制作。"
  ],
  "chapter.5A0FF97AED39E75E.title": "第一章 · 从小屋出发",
  "quest.0464CA606F343573.title": "走出聚落",
  "quest.0464CA606F343573.quest_desc": [
    "离开小屋，走到距离起点至少 96 格的地方，寻找树林、石头和矿洞。",
    "猩红与腐化区域已经生成，但在击败史莱姆王之前无法进入；不必在边界上反复尝试。"
  ],
  "quest.1991EA50DCDCE562.title": "准备下矿",
  "quest.1991EA50DCDCE562.quest_desc": [
    "制作一把石镐。食物、照明和其他工具由你自行准备；本次试作暂不额外赠送。"
  ],
  "quest.4500C181673A4FB3.title": "材料的另一种用法",
  "quest.4500C181673A4FB3.quest_desc": [
    "查看 JEI，制作泥土模板。当前无限之核使用材料直接合成模板，不需要空白模板。"
  ],
  "quest.2039A0EE2EAB186F.title": "第一个泥土生成器",
  "quest.2039A0EE2EAB186F.quest_desc": [
    "亲手合成一个泥土生成器：8 个泥土模板围绕 1 块橡木木板。",
    "这一节点检测真实合成记录，单纯领取或捡到方块不算完成。"
  ],
  "quest.13DACF956E61E42F.title": "一套基础机械方块",
  "quest.13DACF956E61E42F.quest_desc": [
    "制作传动杆、齿轮、手摇曲柄和安山机壳各 1 个。先用手摇曲柄理解转动与传动。",
    "本次试作检测持有这些部件；自动化规模、动力指标与配方调整后续再展开。"
  ],
  "quest.441D1DEFF4C0B58E.title": "第一次首领挑战：史莱姆王",
  "quest.441D1DEFF4C0B58E.quest_desc": [
    "做好装备与补给，按汇流来世的原生方式召唤并击败史莱姆王。",
    "召唤条件以当前模组实际玩法与 JEI 为准。本章不改写汇流来世原生首领进度。",
    "史莱姆王击败记录按整个存档共享。普通史莱姆、首领仆从和取消的死亡不会打开区域。"
  ]
}
