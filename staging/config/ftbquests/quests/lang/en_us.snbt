{
  "quest.4B61DD93ABC703EA.title": "在小屋里醒来",
  "quest.4B61DD93ABC703EA.quest_desc": [
    "你想不起自己的来处。身边有一把剑，行囊里还有一个维度网络发生器，进世界时会自动发给你。再领些面包、火把和原木，记住回小屋的路。",
    "小屋外有两件事可先做：去找矿洞，或带噬星之刃试一剑。两边都准备好，再去挑战史莱姆王。",
    "{\"text\":\"翻开旅人手记 · 我该从哪儿走\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"342CE32A04725ED3\"}}"
  ],
  "quest.36C3A881016E5E96.title": "第一趟矿洞",
  "quest.36C3A881016E5E96.quest_desc": [
    "从聚落地面往下至少 12 格，亲手挖一块石头或矿石。带回 32 圆石、8 煤炭和 6 粗铁。",
    "工作台边要做原料生成器，空地上要搭传动。矿工补给里的铜铁也够你做第一把泰拉兵器。"
  ],
  "quest.49639F9E7F91B628.title": "机械动力的起点",
  "quest.49639F9E7F91B628.quest_desc": [
    "制作 4 个安山合金，留给接下来的传动部件。"
  ],
  "quest.04E0645E6BC170B0.title": "为旅途建立后方",
  "quest.04E0645E6BC170B0.quest_desc": [
    "试车后领取木桶，放在回家顺路的位置，打开它存放行装。取用过已有木桶也算。把下一趟要用的兵器和饰品留在手边。"
  ],
  "quest.259C64DF4D981F3C.title": "通往猩红与腐化的道路",
  "quest.259C64DF4D981F3C.quest_desc": [
    "史莱姆王倒下，镇外原本走不通的边境已经开放。带斧子去趟猩红或腐化，查查那里的木料能用来修什么。",
    "{\"text\":\"完成后翻开手记 · 第一次认得回家的路\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"30BF0ECE49E4C122\"}}"
  ],
  "chapter.5A0FF97AED39E75E.title": "序章 · 从小屋出发",
  "quest.0464CA606F343573.title": "走出聚落",
  "quest.0464CA606F343573.quest_desc": [
    "沿小镇外的路走出至少 96 格，找一处矿洞。猩红和腐化的边界会在史莱姆王倒下后打开。"
  ],
  "quest.1991EA50DCDCE562.title": "准备下矿",
  "quest.1991EA50DCDCE562.quest_desc": [
    "做一把石镐。带上火把和垫脚石，把暂时用不到的东西留在家里。"
  ],
  "quest.4500C181673A4FB3.title": "材料的另一种用法",
  "quest.4500C181673A4FB3.quest_desc": [
    "在 JEI 中查看泥土模板的配方，先用泥土做出第一个模板。"
  ],
  "quest.2039A0EE2EAB186F.title": "第一个泥土生成器",
  "quest.2039A0EE2EAB186F.quest_desc": [
    "在工作台中间放橡木木板，周围摆满 8 个泥土模板。亲手做出的生成器可以持续供应泥土。"
  ],
  "quest.13DACF956E61E42F.title": "一套基础机械方块",
  "quest.13DACF956E61E42F.quest_desc": [
    "备齐传动杆、齿轮、手摇曲柄和安山机壳各 1 个。生成器与机械部件备好后，选变速齿轮或传送带试车。"
  ],
  "quest.441D1DEFF4C0B58E.title": "第一次首领挑战：史莱姆王",
  "quest.441D1DEFF4C0B58E.quest_desc": [
    "选一处开阔地，使用史莱姆皇冠召唤史莱姆王。横向跑开它的落点，等它落地再还击。",
    "{\"text\":\"首领战册 · 史莱姆王\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"35B312A8CFC0CEFF\"}}"
  ],
  "quest.4E2E6DEF9B35CC9D.title": "合成自然罗盘",
  "quest.4E2E6DEF9B35CC9D.quest_desc": [
    "击败史莱姆王后，亲手做一个自然罗盘。用它搜索腐化或猩红，出发前记下回家的方向。"
  ],
  "quest.280D401DA2351897.title": "合成探险者指南针",
  "quest.280D401DA2351897.quest_desc": [
    "击败史莱姆王后，亲手做一个探险者指南针。选择结构名称，它会指引你寻找遗迹。"
  ],
  "chapter.6BFCB3A5A742DFD0.title": "第一章 · 重启第一座工坊",
  "quest.69B3711BF25E107B.title": "旧工坊的委托",
  "quest.69B3711BF25E107B.quest_desc": [
    "镇上流传着古代英雄封住受侵蚀土地的故事。边境那座工坊究竟是怎样停下来的？先做一把能读出旧设备状态的工具，再进去看看。",
    "两路可以同时开工。采样的人带斧子取木样，留守的人架水车、压板材。等纤维磨好，选侧送或下料，把原料送上生产线，再开搅拌器。"
  ],
  "quest.49A552499965E073.title": "越过边境",
  "quest.49A552499965E073.quest_desc": [
    "走进腐化或猩红，收集 4 个乌木原木或暗影原木，两种可以混用。把木样送进磨石。"
  ],
  "quest.599B7AB467C23AF0.title": "让动力持续运转",
  "quest.599B7AB467C23AF0.quest_desc": [
    "让压机、磨石或搅拌器转起来，在旁边累计观察 10 秒。小水车可带动 8 RPM 的支路；用大小齿轮分两级增速，把搅拌器提到 32 RPM。"
  ],
  "quest.6E074E85FED06EAC.title": "第一批精密零件",
  "quest.6E074E85FED06EAC.quest_desc": [
    "接好压机，把锭放到压头正下方的置物台上试压。备 7 张铁板和 2 张铜板，先拿起整批板材再用。5 张铁板和 2 个安山合金做搅拌头，其余留给调谐器。"
  ],
  "quest.6B8E22D501AC0EA9.title": "异常材料的用途",
  "quest.6B8E22D501AC0EA9.quest_desc": [
    "剖开边境木样之前，先把磨石转起来。4 个原木磨出 8 份浸染纤维，正好是下一锅共振胶的原料。"
  ],
  "quest.136EB0CDAD110108.title": "稳定的共振胶",
  "quest.136EB0CDAD110108.quest_desc": [
    "把试送过的纤维送进工作盆，每锅下 2 份纤维、1 红石粉和 1 黏液球或凝胶。接上达到 32 RPM 的搅拌器，开机冷拌。取出 4 份装进背包，1 份粘调谐器，3 份带去修继电器。"
  ],
  "quest.228109ABBD3E71FA.title": "粗制调谐器",
  "quest.228109ABBD3E71FA.quest_desc": [
    "工作台上排摆铜板、玻璃、铜板；中排摆铁板、共振胶、铁板；下排中央放传动杆。",
    "在主世界用调谐器对空气右键领地图。带上 3 份胶、水车和传动件再出发。"
  ],
  "quest.24BD52ACFB3E6BD0.title": "找到旧址",
  "quest.24BD52ACFB3E6BD0.quest_desc": [
    "顺勘测图进工坊，先找原料经过的动力室，再找换向装置和屋顶信号台。可以读一台继电器，也可以先拍下现场。",
    "旧存档可往新生成的区块找。地图遗失时，在主世界用调谐器对空气右键补领。"
  ],
  "quest.7A22062328908A03.title": "三处故障",
  "quest.7A22062328908A03.quest_desc": [
    "把轴端对准节点正面的彩色接口，三个节点都要达到 8 RPM，换向节点还要正转。用调谐器右键读转速，反向时加一对齿轮换向。",
    "每处达标后长按右键约 3 秒，用掉 1 份共振胶。在同一座工坊修好三处。"
  ],
  "quest.4FB59596BCAF8408.title": "工坊重新亮起",
  "quest.4FB59596BCAF8408.quest_desc": [
    "三处都亮起后，保持供能，再操作中央控制台。曾经有人靠这套传动修工具，如今你也可以把它交给下一个来修理的人。",
    "维修簿通向三项新的调查。把奖励中的共振胶留给档案台。",
    "{\"text\":\"完成后翻开手记 · 维修簿里的箭头\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"30BF0ECE49E4C122\"}}"
  ],
  "quest.5B7CF06798316864.title": "支线 · 另一种异常",
  "quest.5B7CF06798316864.quest_desc": [
    "分别到腐化和猩红，各收集 4 个当地原木。两份边境标本可以挂进展示框。"
  ],
  "quest.0712DF7A63B058CE.title": "支线 · 从手作到量产",
  "quest.0712DF7A63B058CE.quest_desc": [
    "侧送和下落任选一种完成试车，再把铜板产量做到 16 张。调谐器用掉的铜板也算。领回隧道、漏斗和传送带，给下一批留出进出料的位置。"
  ],
  "quest.2AB221424C3AB34C.title": "支线 · 野外见闻录",
  "quest.2AB221424C3AB34C.quest_desc": [
    "走进三种不同的 Explorify 野外遗迹，例如营地、路标和补给藏点。"
  ],
  "quest.1A2D41F3F0565916.title": "支线 · 第一次远征纪念",
  "quest.1A2D41F3F0565916.quest_desc": [
    "亲自拍摄三张不同的照片，冲洗并打印，收进背包。工坊复工前后的景象就值得留一对。"
  ],
  "quest.01646532D249D22F.title": "支线 · 沉睡的铁甲",
  "quest.01646532D249D22F.quest_desc": [
    "去钢铁守护者室挑战沉睡的守卫。等它的重击落空，再绕到背后出手。",
    "{\"text\":\"首领战册 · 钢铁守护者\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"70C86B17DE824438\"}}"
  ],
  "chapter.08D219867E4DF589.title": "第二章 · 遗产调查",
  "quest.1697E0EFFE71246B.title": "维修簿之外",
  "quest.1697E0EFFE71246B.quest_desc": [
    "旧工坊复工了，维修簿里的做法还有多少能用？工匠可以重新装配精密构件，术士可以重做一次施法，探路的人去查遗迹与守敌。",
    "工程、奥术、远征任选两份成果即可建档。工程队可分成两班：一班烧黄铜、备构件，一班架泵、铺管道，最后合装一台真正能用的调速器。"
  ],
  "quest.1C2F30D09583F848.title": "工程 · 让火进入工艺",
  "quest.1C2F30D09583F848.quest_desc": [
    "用空燃烧室在下界捕获烈焰人。给燃烧室添燃料，在上方的工作盆搅拌铜锭和锌锭；每对出 2 黄铜锭，备齐 8 锭。"
  ],
  "quest.2D5031EB24DB5DB1.title": "工程 · 可重复的精密工艺",
  "quest.2D5031EB24DB5DB1.quest_desc": [
    "让机械手真正加工一次，注液器也完成一次灌装。两个岗位可以交给不同的人，取得的精密构件留给调速器。",
    "以金板起步，依次部署小齿轮、大齿轮、铁粒，重复 5 轮。构件成功率为 80%，给流水线留一点余料。"
  ],
  "quest.377BDBD8E94E1CD6.title": "整理工程记录",
  "quest.377BDBD8E94E1CD6.quest_desc": [
    "工程总档收下了试车记录。试装的调速器留给基地，用机械臂和黄铜漏斗给归来的样本做一条分拣线。"
  ],
  "quest.7D0AC0F11F02C768.title": "奥术 · 选择研究方法",
  "quest.7D0AC0F11F02C768.quest_desc": [
    "选一种研究方法。铁魔法用铭文台准备铁质法术书，再装备到法术书栏；诡厄巫法从黑暗魔杖入手。"
  ],
  "quest.00A2188434EF341F.title": "奥术 · 让知识发挥作用",
  "quest.00A2188434EF341F.quest_desc": [
    "继续同一种方法。铁魔法从装备好的法术书施放一次法术；诡厄巫法召出僵尸仆从，让它击败一个敌对生物。"
  ],
  "quest.271A129FAC02FC2C.title": "整理奥术记录",
  "quest.271A129FAC02FC2C.quest_desc": [
    "术式已经验证。用领到的附魔台和书架，在基地给法具留一间研究室。"
  ],
  "quest.3D8234164AB33DB0.title": "远征 · 走入两处遗产",
  "quest.3D8234164AB33DB0.quest_desc": [
    "远征队要交两样东西：两类遗迹的坐标，以及一场首领战果。两件事可按行程先后完成。钢铁守护者室、附魔剑冢、沙漠遗址、古代工厂任选两类走入。",
    "指南针可搜 wrought_chamber、enchanted_sword_shrine、desert_site、ancient_factory。"
  ],
  "quest.2A804883BB0B2318.title": "远征 · 一次自选挑战",
  "quest.2A804883BB0B2318.quest_desc": [
    "任选一位对手：钢铁守护者、霜冻巨兽、克苏鲁之眼、世界吞噬怪、克苏鲁之脑或骷髅领主。",
    "想找骷髅领主，可用指南针搜 goety:crypt，到诡厄的大坟墓查看罐子。",
    "{\"text\":\"挑选对手 · 六项调查委托\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6DC7AAD8E935A5D8\"}}"
  ],
  "quest.7FB7517299ACEB24.title": "整理远征记录",
  "quest.7FB7517299ACEB24.quest_desc": [
    "地点和战果都到手了，把这次远征写进总档。下一队就能从档案台绘图，循着你的坐标再来。"
  ],
  "quest.2892644A45456FAE.title": "让两条线索相遇",
  "quest.2892644A45456FAE.quest_desc": [
    "旧日的工程与术式曾在同一座文明里发展。如今散落的工艺、术式、遗址坐标，又有两份能摆回同一张桌上。找个队友都方便取用的位置建档。"
  ],
  "quest.760440CC9AACAC51.title": "建一处保存知识的地方",
  "quest.760440CC9AACAC51.quest_desc": [
    "工作台上排摆书、玻璃、书；中排摆铜板、安山机壳、铜板；下排摆木板、共振胶、木板。做好遗产档案台并放下。"
  ],
  "quest.76FC61C7DB7BD176.title": "我们的遗产档案",
  "quest.76FC61C7DB7BD176.quest_desc": [
    "空手右键档案台领取档案书，带回旧书可更新。潜行右键选地点，再松开潜行，持空地图右键绘图。",
    "下次出队要往下界走。把调谐器、共振胶和档案书收在一起，出发时直接取走。",
    "{\"text\":\"完成后翻开手记 · 翻开第一册档案\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"30BF0ECE49E4C122\"}}"
  ],
  "quest.26D9E56E31143A19.title": "可选 · 完整的三路调查",
  "quest.26D9E56E31143A19.quest_desc": [
    "把第三条线索也调查完，补齐工程、奥术和远征三份记录。"
  ],
  "chapter.759CB26DEA732B94.title": "第三章 · 世界转折",
  "quest.2B08699FB66C78B4.title": "去往下界之前",
  "quest.2B08699FB66C78B4.quest_desc": [
    "从档案台收好书，把修过工坊的粗制调谐器和 1 份共振胶带进下界。取样要靠前队，做饭可以留给灶边的人。",
    "击败血肉首领会让世界进入困难模式，部分地形随之转化。准备动手时，先把退路或口粮试好。"
  ],
  "quest.6A44FF99927AF1BD.title": "击败血肉首领",
  "quest.6A44FF99927AF1BD.quest_desc": [
    "在下界击败巫毒恶魔可拿到向导巫毒玩偶。看玩偶的提示选好形态，准备就绪再投进岩浆。",
    "血肉墙或血肉山，击败其中一位。拿到宝藏袋就先开袋，收好下一趟敲祭坛要用的神锤。",
    "{\"text\":\"下界备忘 · 形态与战后变化\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"29A906D9451C6C57\"}}"
  ],
  "quest.70B98B2219093652.title": "世界已进入困难模式",
  "quest.70B98B2219093652.quest_desc": [
    "上次归档的坐标还在，地图外的土地却已经开始变化。带档案书回档案台查看转化进度，再拿神锤去找祭坛。"
  ],
  "quest.24BA016E81A9BDB9.title": "第一炉新矿",
  "quest.24BA016E81A9BDB9.quest_desc": [
    "首批产品带一锭到手里，把硬质边料收在工坊；下一班要做能反复铆合轨料和灯座的施工夹模。普通炉料仍可直接熔 2 锭。",
    "{\"text\":\"完成后翻开手记 · 神锤响过以后\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"30BF0ECE49E4C122\"}}"
  ],
  "chapter.2D5047AC1452BE5B.title": "第四章 · 困难模式整备",
  "quest.6BEB2BDDDE4B91BF.title": "把新矿带上工作台",
  "quest.6BEB2BDDDE4B91BF.quest_desc": [
    "第一炉钴或钯金该给谁？矿班用它追下一层矿脉，护卫用它把人平安带回来。先选一班，另一班的委托也会留着。",
    "在工作台里竖排叠放工作台、铁砧或铅砧、工作台。做出的重型工作台放在炉边，已有的空手打开即可。"
  ],
  "quest.5C52AA144E887000.title": "采掘 · 换上新工具",
  "quest.5C52AA144E887000.quest_desc": [
    "在重型工作台做好一把镐或钻头，拿到主手。钴镐要 15 锭、钴钻头 12 锭，钯金两种工具各要 18 锭。做镐另备 3 根珍珠木棍。"
  ],
  "quest.60BCE50D3F42F766.title": "战斗 · 选一套合身的盔甲",
  "quest.60BCE50D3F42F766.quest_desc": [
    "穿齐同种材料的头、胸、腿、靴。护卫可以带惯用的武器去巡夜，钴甲的头部最好按兵器来选。",
    "{\"text\":\"查手册 · 钴甲与钯金甲\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"46BAC8D6E3A42B63\"}}"
  ],
  "quest.7E82D9E88152A714.title": "把整备用起来",
  "quest.7E82D9E88152A714.quest_desc": [
    "采到第二层矿，或穿新甲挡过近敌和射手，就能接遗址远征。回工坊带上两份热封行军餐，别把压机和厨锅留到临行才开。",
    "{\"text\":\"完成后翻开手记 · 谁来试这批新料\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"30BF0ECE49E4C122\"}}"
  ],
  "quest.003111937F6E15CC.title": "选修 · 下一阶锻造",
  "quest.003111937F6E15CC.quest_desc": [
    "用重型工作台把 10 秘银锭或 12 山铜锭，搭配 3 块珍珠木板，做成对应的困难砧。"
  ],
  "quest.65A8CA872474A532.title": "下界 · 从岩浆块取样",
  "quest.65A8CA872474A532.quest_desc": [
    "主手拿调谐器、副手放共振胶，右键下界的岩浆块。一次带回 2 份热样胶，够在压机下封两餐。"
  ],
  "quest.6CF98D5A1B67EC4C.title": "后方 · 备一锅饭",
  "quest.6CF98D5A1B67EC4C.quest_desc": [
    "在热源上架起厨锅。蔬菜汤、鸡汤、炖牛肉、炒饭任选一道，盛出送到工坊。家里有生牛肉、胡萝卜和马铃薯，就做炖牛肉。"
  ],
  "quest.01CBB2DD4D43F373.title": "工坊 · 压封行军餐",
  "quest.01CBB2DD4D43F373.quest_desc": [
    "把 1 份料理、1 张铜板、1 份热样胶投入压机下的工作盆。压好行军餐，带一份出门；每份补充 8 点饥饿值，还能抗火 90 秒。",
    "接下来任选一职。工兵留三盏引路灯，先锋吃下行军餐试战。两项都做，可以再接一单后队口粮。"
  ],
  "quest.4949B108C7E78A72.title": "回程 · 给地狱熔炉配料",
  "quest.4949B108C7E78A72.quest_desc": [
    "用神锤敲祭坛显出矿物。把 6 份同种粗钴或粗钯金放入工作盆，用机械搅拌器冷拌成一块炉料。给下一炉做精炼，可多出一锭，还能留下一片制模边料。"
  ],
  "chapter.3ABD0124FB8AEDA1.title": "第五章 · 遗址远征",
  "quest.2A5C04757DCBFF09.title": "工坊配给 · 整装出发",
  "quest.2A5C04757DCBFF09.quest_desc": [
    "带上 2 份热封行军餐来领图纸、笔和照明。地下墓穴或林地府邸选一处走；这趟的要紧事，是让后来的人也能找到入口。",
    "一处就可交差：写手记、拍照片或挑战当地首领。喜欢找路也有第四种办法：踏勘两处，到档案室展图。"
  ],
  "quest.4E12304BAD37FF5B.title": "墓穴线 · 找到地下墓穴",
  "quest.4E12304BAD37FF5B.quest_desc": [
    "用归途指南针找铁魔法地下墓穴，或用探险者指南针搜 irons_spellbooks:catacombs。进门稍作停留，档案台便会记下坐标。",
    "先踩出一条回地面的路。在入口写手记或拍照就可回程，想探内室再去找死者之王。"
  ],
  "quest.646D06C50CFE205B.title": "府邸线 · 查明林地据点",
  "quest.646D06C50CFE205B.quest_desc": [
    "循林地探险家地图出发，或用探险者指南针搜 minecraft:mansion。进入府邸稍作停留，档案台会记住首个地点。",
    "把靠近入口的房间记在手记里，或趁光线好留一帧。带了黑暗卷轴的队伍还可在这里挑战灾厄宰相。"
  ],
  "quest.33B054D584DD1602.title": "交回远征地图",
  "quest.33B054D584DD1602.quest_desc": [
    "回档案台，空手潜行右键选中已发现的墓穴或府邸。松开潜行，手持空地图右键，换一张标好坐标的归档图。",
    "手记、照片、当地战报或双地踏勘，交任一份。收起归档图，下一趟要给远征队安一只补给桶。",
    "{\"text\":\"完成后翻开手记 · 地图给谁看\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"30BF0ECE49E4C122\"}}"
  ],
  "quest.3E5955E508399D8A.title": "自选讨伐 · 死者之王",
  "quest.3E5955E508399D8A.quest_desc": [
    "先留好回程路线，再深入墓穴与沉睡的遗骸互动。击败现身的死者之王，这份战报可以用来归档，第六章驻地也会认领。",
    "{\"text\":\"首领战册 · 死者之王\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"45966785EFF70FB9\"}}"
  ],
  "quest.093F5AD1EFBF4A19.title": "自选讨伐 · 灾厄宰相",
  "quest.093F5AD1EFBF4A19.quest_desc": [
    "把黑色染料、魔法布料、不死图腾从上到下竖排，制成黑暗卷轴。在府邸内长按使用，迎战灾厄宰相。本人或仆从留下的击败记录都能交差。",
    "{\"text\":\"首领战册 · 灾厄宰相\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"69BAF0BABD7CB422\"}}"
  ],
  "chapter.2B9783ABBA2533ED.title": "第六章 · 前线补给站",
  "quest.50A0C915D6A748F0.title": "地图的另一端",
  "quest.50A0C915D6A748F0.quest_desc": [
    "归档图上多了一个你亲自走过的地方。下一班人可没走过这趟。拿普通指南针领木桶和营火，沿图再走一次。",
    "营地缺三样：能吃的、能救急的、能把货送来的。给厨房和救援队各送两包，或替其中一队送货，再把货运线修到前线。最后凭纸在桶里领一包，到遗址旁拆用。"
  ],
  "quest.72AE6BEF433C5981.title": "把木桶留在遗址旁",
  "quest.72AE6BEF433C5981.quest_desc": [
    "靠近归档标记找一块平地，水平半径 128 格内都可设站。墓穴深处难扎营，就到它正上方的地表。",
    "在木桶任意一侧同高紧贴点燃营火，主手持普通指南针，潜行右键木桶盘点。看到库存数字，站址就定了。先把纸收在背包里，领用时再换到副手。",
    "矿班压过的铁轨可铺向站口，护卫备的灯笼能照亮卸货处。收件蛙港以后要坐在木桶正上方，先给它留个位置。"
  ],
  "quest.171905731D32BC2C.title": "厨房排班 · 装一包行粮",
  "quest.171905731D32BC2C.quest_desc": [
    "用第三章的生产线接第一单。压机下的工作盆放 2 份热封行军餐、2 煤炭、2 木棍、1 纸，冷压一包。备齐两包就可送到营地。"
  ],
  "quest.659C865DF9E619B4.title": "救援排班 · 扎紧吊绳",
  "quest.659C865DF9E619B4.quest_desc": [
    "墓穴里要能止住伤势，也要有办法爬上来。在压机下用工作盆把 1 金苹果、6 竹子、1 线、1 纸压成一包。备齐两包交给营地。"
  ],
  "quest.5E571ACF5BDFCC0D.title": "货运试车 · 封上第一箱",
  "quest.5E571ACF5BDFCC0D.quest_desc": [
    "把打包机贴住库存，给它红石信号封出第一箱。先用一箱圆石试车，再把正式货物送上运输线。"
  ],
  "quest.503397AB7E037027.title": "行粮到站",
  "quest.503397AB7E037027.quest_desc": [
    "在营地同一只木桶存 2 个野外补给包，用指南针潜行右键盘点。包留在桶里，每包可拆出 2 份行军餐和 8 支火把。"
  ],
  "quest.15DDC5E8C3DCBB88.title": "救援物资到站",
  "quest.15DDC5E8C3DCBB88.quest_desc": [
    "在营地同一只木桶存 2 个救援补给包，用指南针盘点。每包能拆出 1 个金苹果和 6 个脚手架。"
  ],
  "quest.7881A417D597920F.title": "货运试车 · 空线走一趟",
  "quest.7881A417D597920F.quest_desc": [
    "工坊先做一小段试车线：用锁链连接两个锁链传动轮并供能。手持货物蛙港右键锁链，再放在链旁。发件蛙港坐在打包机上，把连着另一段链的收件蛙港放到空桶上。",
    "给发件打包机贴写有收件地址的告示牌，把收件蛙港设为同名地址。亲自放置收件蛙港，发一箱试车货，等它从链上取箱，再领修长线的材料。"
  ],
  "quest.77CBB65AB509D459.title": "交班 · 签领一份储备",
  "quest.77CBB65AB509D459.quest_desc": [
    "行粮、救援、货运办妥两项，值守的人就能交班。木桶里至少留 1 个拆掉外箱、仍未使用的补给包，背包腾出收货的位置。",
    "副手拿普通纸、主手持指南针，潜行右键营地木桶。账房收走一张纸，从桶中按格子顺序取出第一包补给交到你手里。站在遗址水平 128 格内，手持补给包对空气右键拆用。",
    "锅还可以接着煮，桶里的东西也留给下一趟。收下交班配给，再选一本适合自己的附魔书。",
    "{\"text\":\"完成后翻开手记 · 桶边的火\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"30BF0ECE49E4C122\"}}"
  ],
  "quest.5318074CD6C4F2D3.title": "驻地餐桌 · 摆一桌盛宴",
  "quest.5318074CD6C4F2D3.quest_desc": [
    "做一道能上桌的农夫乐事盛宴，摆出来让同伴分食。烤鸡和酿南瓜都合适。"
  ],
  "quest.32FB350E20090686.title": "药房备货 · 强效治疗",
  "quest.32FB350E20090686.quest_desc": [
    "在汇流来世炼药桌加入 3 瓶瓶装水、3 妖精尘、1 水晶碎块。带上产出的 3 瓶强效治疗药水。"
  ],
  "quest.638007FFF663A3AD.title": "夜哨底片",
  "quest.638007FFF663A3AD.quest_desc": [
    "游戏时间 13000 至 23000，用相机拍到僵尸、骷髅或掠夺者。再亲手冲印一张自选照片，挂进值班室。"
  ],
  "quest.4DE233CFEF449102.title": "驻地委托 · 收回通行路线",
  "quest.4DE233CFEF449102.quest_desc": [
    "回到墓穴挑战死者之王，或在府邸邀战灾厄宰相。第五章已带回一份战报，驻地就可以直接结算这笔赏金。",
    "{\"text\":\"查阅两份驻地悬赏\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6A397FA1121CD9FD\"}}"
  ],
  "quest.48F94E85B08F7E71.title": "扩建验收 · 两套常备库存",
  "quest.48F94E85B08F7E71.quest_desc": [
    "开通全部三项业务后，把两种补给各 4 包同时存进一只营地木桶，持指南针盘点。"
  ],
  "quest.5456B1A0E7DA4FB1.title": "投下第一点",
  "quest.5456B1A0E7DA4FB1.quest_desc": [
    "领取小屋任务的加点卷轴，右键得到 1 点。打开「加点界面」，在一条数值属性上按 +1。生命上限适合第一次出门，也可以投资移速或伤害。",
    "开发版按 N，模组默认 K。挖矿、首次合成和打怪都能积攒角色经验；想比较属性，翻开与卷轴一起领到的加点手册。"
  ],
  "quest.7BDB69CBFB808984.title": "噬星之刃 · 打开成长剑谱",
  "quest.7BDB69CBFB808984.quest_desc": [
    "你还记不起这把剑的来历，先翻开它的剑谱。按成长菜单键（默认 G），或输入 /bladefolio。",
    "翻到「成长」就会登记。看看离下一阶还差多少成长点，再带上剑去镇外试试。",
    "云朵瓶、赫尔墨斯靴、再生手环任选一件。领奖前可以翻开手册比较。",
    "{\"text\":\"查手册 · 开荒饰品怎么选\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"45935826E246E542\"}}"
  ],
  "quest.213A9A128CAD6BCE.title": "兵器架 · 铜阔剑",
  "quest.213A9A128CAD6BCE.quest_desc": [
    "主手用铜阔剑命中一只敌怪，打完一剑就退到落点外。锡、铅、银、钨、金、铂金阔剑也可练习。",
    "{\"text\":\"查手册 · 铜阔剑的属性和配方\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0110E6E4E3976E2C\"}}"
  ],
  "quest.29910F7881ADB6DA.title": "兵器架 · 金属弓",
  "quest.29910F7881ADB6DA.quest_desc": [
    "主手持泰拉弓射中僵尸、骷髅、蜘蛛或史莱姆，等箭命中再换手。木短弓和铜至铂金的金属长短弓均可。",
    "{\"text\":\"查手册 · 铁弓的属性和配方\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"04D1B369E3B2319C\"}}"
  ],
  "quest.71919EA229FC8120.title": "兵器架 · 宝石法杖",
  "quest.71919EA229FC8120.quest_desc": [
    "主手施法，让宝石弹命中僵尸、骷髅、蜘蛛或史莱姆。紫晶、黄玉、蓝玉、红玉和钻石法杖均可。",
    "{\"text\":\"查手册 · 紫晶法杖与魔力准备\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5C66D939EC5F1860\"}}"
  ],
  "quest.6B3AEF5579D1E440.title": "把饰品戴上",
  "quest.6B3AEF5579D1E440.quest_desc": [
    "练熟一门兵器，再选一件搭配它的饰品。想越过落点就带云朵瓶，想在平地放风筝就穿跑鞋。把开荒分册里任意一件戴进背包的饰品栏。",
    "{\"text\":\"看七件开荒饰品 · 属性与获取\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"45935826E246E542\"}}",
    "{\"text\":\"翻开整本装备手册\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"684C355CAD5A8963\"}}"
  ],
  "quest.4EE951BF8047A144.title": "王冠与退路",
  "quest.4EE951BF8047A144.quest_desc": [
    "备一顶金冠或铂金冠，在工作台用 8 个凝胶围住它，得到史莱姆皇冠。先把床和备用食物安顿在战场边。",
    "清出一段可横移的平地，放两层错开的平台。看到史莱姆王起跳，先离开落点再还击。",
    "{\"text\":\"战前翻阅 · 装备手册\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"684C355CAD5A8963\"}}",
    "{\"text\":\"对照召唤物与退路\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"35B312A8CFC0CEFF\"}}"
  ],
  "quest.1AD32E2C8ED462C4.title": "老兵委托 · 三门兵器",
  "quest.1AD32E2C8ED462C4.quest_desc": [
    "熟手可以用三种泰拉武器各命中一次敌人，再击败史莱姆王，直接提交战报。更新前已打通边境的世界可沿用原战果。"
  ],
  "quest.0370187D6B231F81.title": "剑谱 · 第一束剑气",
  "quest.0370187D6B231F81.quest_desc": [
    "噬星之刃到二阶后，主手持剑，对准前方按右键放出剑气。标准路线累计 150 成长点可到二阶，击败史莱姆王也是一笔成长。",
    "四阶时可潜行右键释放爆发。剑谱的「形态」页列出各阶所需的成长点和首领战果。"
  ],
  "quest.73D976C55BE9E545.title": "开工勘测 · 读继电器",
  "quest.73D976C55BE9E545.quest_desc": [
    "拿粗制调谐器右键旧工坊里的一台继电器，读出接口故障。记下需要接轴的那一面，先布置水车和齿轮。",
    "读设备和拍现场两种勘测任选一种即可开工。"
  ],
  "quest.7E1885917CDC8351.title": "开工勘测 · 拍现场",
  "quest.7E1885917CDC8351.quest_desc": [
    "给拾光定影的相机装上胶卷，站进工坊，在控制台或屋顶信号台旁拍一帧。按下快门就能回去布置传动。"
  ],
  "quest.1AE60BE61CDFB7AE.title": "远征档案室 · 地图上墙",
  "quest.1AE60BE61CDFB7AE.quest_desc": [
    "在档案台选一处已发现的遗迹，持空地图绘图。把带目标标记的归档地图放进普通或荧光展示框，给下一队人留下路线。"
  ],
  "quest.4D04B92651DCACB9.title": "工兵 · 给退路点灯",
  "quest.4D04B92651DCACB9.quest_desc": [
    "沿下界退路放三盏灯笼，可混用灵魂灯笼。手持调谐器依次右键，每两站相隔 12～32 格，终点距起点至少 24 格。三盏都留在原位。"
  ],
  "quest.6A89A848189809CD.title": "先锋 · 耐火试战",
  "quest.6A89A848189809CD.quest_desc": [
    "在下界吃一份热封行军餐，趁这 90 秒抗火时间击败烈焰人或岩浆怪。"
  ],
  "quest.05C3B5ABE28C81AC.title": "采掘队 · 探到第二层矿脉",
  "quest.05C3B5ABE28C81AC.quest_desc": [
    "主手用钴或钯金镐钻，从深板岩中采出一块秘银矿或山铜矿。神锤敲开更多祭坛，可以显出下一层矿脉。"
  ],
  "quest.3E7102F7DAA60E52.title": "护卫队 · 两种交锋",
  "quest.3E7102F7DAA60E52.quest_desc": [
    "穿齐钴甲或钯金甲。击败一只近敌（僵尸、尸壳、蜘蛛）和一只射手（骷髅、流浪者、掠夺者），两场可换武器。"
  ],
  "quest.506301D381EF9278.title": "测绘员 · 写一页现场手记",
  "quest.506301D381EF9278.quest_desc": [
    "主手拿羽毛，副手放纸。走进地下墓穴或林地府邸，潜行右键遗址中的方块，留下一张带实地坐标的手记。"
  ],
  "quest.6D5B56E25E848D5C.title": "摄影师 · 遗址里的第一帧",
  "quest.6D5B56E25E848D5C.quest_desc": [
    "带装好胶片的拾光定影相机，站在地下墓穴或林地府邸内部按下快门。带一帧照片回来，也算调查凭据。"
  ],
  "quest.1BABC98BEF700C36.title": "守夜人的破围剑",
  "quest.1BABC98BEF700C36.quest_desc": [
    "噬星之刃达到四阶后，主手持剑，潜行右键施放爆发。守夜时留着这招，等敌人聚拢再出手。"
  ],
  "chapter.15833C8EAA8EC0A0.title": "装备手册 · 武器与饰品",
  "quest.684C355CAD5A8963.title": "装备手册 · 目录",
  "quest.684C355CAD5A8963.quest_desc": [
    "点击下列分册查看装备。饰品放进背包的饰品栏，武器拿在主手，套装穿在四个护甲位。",
    "{\"text\":\"全盔甲 · 按单件护甲值查阅\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6F67D3AF2352EE0B\"}}",
    "{\"text\":\"全饰品 · 从材料追到成品\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"052784AEB4F7DBD1\"}}",
    "{\"text\":\"开荒饰品\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"45935826E246E542\"}}",
    "{\"text\":\"进阶饰品\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"381FDE4345973BC2\"}}",
    "{\"text\":\"起手武器\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1BDC6C3FD28BBFCD\"}}",
    "{\"text\":\"护甲与套装\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"46BAC8D6E3A42B63\"}}",
    "从主线点进来时，按退格键可以返回上一个条目。"
  ],
  "quest.45935826E246E542.title": "开荒饰品",
  "quest.45935826E246E542.quest_desc": [
    "想越过史莱姆就选云朵瓶，想在平地拉开距离就选赫尔墨斯靴，受伤后需要续航就选再生手环。试剑奖励可从这三件里挑一件。",
    "{\"text\":\"查所有饰品与合成路线\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"052784AEB4F7DBD1\"}}",
    "{\"text\":\"云朵瓶\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3B0614A0087841A0\"}}",
    "{\"text\":\"赫尔墨斯靴\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0B0B5F710FD5C53A\"}}",
    "{\"text\":\"再生手环\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"13441AEDD6B820ED\"}}",
    "{\"text\":\"鞋带束头\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2AB1120022BECD53\"}}",
    "{\"text\":\"暴雪瓶\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6132EE6DAB4FC629\"}}",
    "{\"text\":\"疾风雪靴\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"357165204E3A2B92\"}}",
    "{\"text\":\"镣铐\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"307923D131E42EC1\"}}",
    "{\"text\":\"返回装备目录\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"684C355CAD5A8963\"}}"
  ],
  "quest.3B0614A0087841A0.title": "云朵瓶",
  "quest.3B0614A0087841A0.quest_desc": [
    "起跳后在空中再按一次跳跃，可踏云再跳一次。安全落差额外增加 3 格。",
    "在地下或洞穴宝箱寻找。也可以在序章「噬星之刃 · 打开成长剑谱」的三件饰品中选它。",
    "对付史莱姆王时，把第二跳留给它的落点，越过去后再回身攻击。",
    "{\"text\":\"展开这件饰品的完整路线\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6D0C966F0D4377B7\"}}",
    "{\"text\":\"相关装备 · 云朵气球\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0ECCBCC9C4D1E48C\"}}",
    "{\"text\":\"返回「开荒饰品」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"45935826E246E542\"}}"
  ],
  "quest.0B0B5F710FD5C53A.title": "赫尔墨斯靴",
  "quest.0B0B5F710FD5C53A.quest_desc": [
    "在地面持续向前移动会逐渐加速，这双靴子最高提供 40% 移速。碰墙或蹲行会打断加速。",
    "可在地下或洞穴宝箱中找到，也可从序章试剑奖励三选一取得。召王前清出一段平地，让靴子有距离提速。",
    "{\"text\":\"展开这件饰品的完整路线\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"50CEA52EF3DAEA7F\"}}",
    "{\"text\":\"相关装备 · 幽灵靴\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"676445251ED4A6E3\"}}",
    "{\"text\":\"返回「开荒饰品」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"45935826E246E542\"}}"
  ],
  "quest.13441AEDD6B820ED.title": "再生手环",
  "quest.13441AEDD6B820ED.quest_desc": [
    "每秒恢复 0.2 点生命，相当于约 5 秒回半颗心。拉开距离绕场时也能回血。",
    "探索地下或洞穴宝箱有机会取得。序章试剑后的三选一奖励也有这只手环。",
    "{\"text\":\"展开这件饰品的完整路线\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3E1FF0F50E925FFB\"}}",
    "{\"text\":\"返回「开荒饰品」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"45935826E246E542\"}}"
  ],
  "quest.2AB1120022BECD53.title": "鞋带束头",
  "quest.2AB1120022BECD53.quest_desc": [
    "佩戴后移动速度提高 5%。在狭窄的平台上调整落点时也能用上。",
    "探索地表宝箱或生命木箱有机会找到。以后制作闪电靴要用到它。",
    "{\"text\":\"展开这件饰品的完整路线\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"66A1F1B291291527\"}}",
    "{\"text\":\"返回「开荒饰品」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"45935826E246E542\"}}"
  ],
  "quest.6132EE6DAB4FC629.title": "暴雪瓶",
  "quest.6132EE6DAB4FC629.quest_desc": [
    "在空中再次按跳跃，借雪风向上跃起。安全落差额外增加 3 格。",
    "去冰雪地区地下找冰冻箱；在雪地钓到的冰冻匣或针叶木匣中也有机会开出。",
    "{\"text\":\"展开这件饰品的完整路线\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"11CD602B9438EC95\"}}",
    "{\"text\":\"返回「开荒饰品」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"45935826E246E542\"}}"
  ],
  "quest.357165204E3A2B92.title": "疾风雪靴",
  "quest.357165204E3A2B92.quest_desc": [
    "在地面持续向前移动会逐渐加速，最高提供 40% 移速。向前奔跑并转弯，可以绕过敌人。",
    "在冰雪地区地下搜冰冻箱，或钓取冰冻匣、针叶木匣。以后可搭配火箭靴制作幽灵靴。",
    "{\"text\":\"展开这件饰品的完整路线\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7C13AAF1284B2B4E\"}}",
    "{\"text\":\"相关装备 · 幽灵靴\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"676445251ED4A6E3\"}}",
    "{\"text\":\"返回「开荒饰品」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"45935826E246E542\"}}"
  ],
  "quest.307923D131E42EC1.title": "镣铐",
  "quest.307923D131E42EC1.quest_desc": [
    "放进饰品格可增加 1 点护甲，可以和身上穿的盔甲一起使用。",
    "击败普通僵尸有机会掉落。前期下矿遇到僵尸时就可以顺手找一件。",
    "{\"text\":\"展开这件饰品的完整路线\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"24361E49DA724CF2\"}}",
    "{\"text\":\"返回「开荒饰品」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"45935826E246E542\"}}"
  ],
  "quest.381FDE4345973BC2.title": "进阶饰品",
  "quest.381FDE4345973BC2.quest_desc": [
    "想把跑鞋继续升级，先留着鞋带束头。击退哥布林军队后，留意来访的哥布林工匠，他出售工匠作坊和火箭靴。近战可看猛爪手套，法师可看魔力花。",
    "{\"text\":\"查所有饰品与合成路线\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"052784AEB4F7DBD1\"}}",
    "{\"text\":\"云朵气球\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0ECCBCC9C4D1E48C\"}}",
    "{\"text\":\"疾风脚镯\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6562867AEBEFA8E1\"}}",
    "{\"text\":\"幽灵靴\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"676445251ED4A6E3\"}}",
    "{\"text\":\"闪电靴\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"704B4A933A986722\"}}",
    "{\"text\":\"猛爪手套\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"73288AAD7048444E\"}}",
    "{\"text\":\"鲨牙项链\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"738D2FEEEC0D7797\"}}",
    "{\"text\":\"大自然的恩赐\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"72C62BA4C4513481\"}}",
    "{\"text\":\"魔力花\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7B370C256A30CD5E\"}}",
    "{\"text\":\"返回装备目录\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"684C355CAD5A8963\"}}"
  ],
  "quest.0ECCBCC9C4D1E48C.title": "云朵气球",
  "quest.0ECCBCC9C4D1E48C.quest_desc": [
    "兼有二段跳和跳跃高度加成，适合从一层平台跃到下一层。",
    "搜空岛宝箱取得闪亮红气球；在哥布林工匠出售的工匠作坊中，将它与 1 个云朵瓶合成。",
    "{\"text\":\"展开这件饰品的完整路线\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7470C7F4FD763059\"}}",
    "{\"text\":\"返回「进阶饰品」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"381FDE4345973BC2\"}}"
  ],
  "quest.6562867AEBEFA8E1.title": "疾风脚镯",
  "quest.6562867AEBEFA8E1.quest_desc": [
    "佩戴后移动速度提高 10%，短距离走位也能受益。",
    "在丛林寻找常春藤箱，或打开丛林匣。收好脚镯，制作闪电靴时需要它。",
    "{\"text\":\"展开这件饰品的完整路线\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3489AB1A80A927EC\"}}",
    "{\"text\":\"返回「进阶饰品」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"381FDE4345973BC2\"}}"
  ],
  "quest.676445251ED4A6E3.title": "幽灵靴",
  "quest.676445251ED4A6E3.quest_desc": [
    "保留地面加速，并能在空中短暂推进。遇到矿洞断层时，可从跑道末端起跳再升高。",
    "向哥布林工匠购买火箭靴和工匠作坊。作坊里用火箭靴配一双底靴，赫尔墨斯靴、疾风雪靴、沙丘行者靴和旗鱼靴都能用。",
    "{\"text\":\"展开这件饰品的完整路线\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2B6A78B92D46BD84\"}}",
    "{\"text\":\"相关装备 · 赫尔墨斯靴\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0B0B5F710FD5C53A\"}}",
    "{\"text\":\"相关装备 · 疾风雪靴\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"357165204E3A2B92\"}}",
    "{\"text\":\"相关装备 · 闪电靴\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"704B4A933A986722\"}}",
    "{\"text\":\"返回「进阶饰品」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"381FDE4345973BC2\"}}"
  ],
  "quest.704B4A933A986722.title": "闪电靴",
  "quest.704B4A933A986722.quest_desc": [
    "继承幽灵靴的飞行和奔跑能力，另外提高 8% 移动速度。",
    "在工匠作坊中合并幽灵靴、鞋带束头和疾风脚镯，各 1 件。先去地表找束头，再去丛林找脚镯。",
    "{\"text\":\"展开这件饰品的完整路线\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0BBCCE373AE05275\"}}",
    "{\"text\":\"相关装备 · 幽灵靴\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"676445251ED4A6E3\"}}",
    "{\"text\":\"相关装备 · 鞋带束头\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2AB1120022BECD53\"}}",
    "{\"text\":\"相关装备 · 疾风脚镯\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6562867AEBEFA8E1\"}}",
    "{\"text\":\"返回「进阶饰品」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"381FDE4345973BC2\"}}"
  ],
  "quest.73288AAD7048444E.title": "猛爪手套",
  "quest.73288AAD7048444E.quest_desc": [
    "攻击速度提高 12%，按住攻击键能连续挥动近战武器。打出一轮后仍要给自己留退路。",
    "可在丛林神庙的宝箱、丛林常春藤箱里寻找，也有机会从丛林匣开出。",
    "{\"text\":\"展开这件饰品的完整路线\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6BA2FE67EBB2FAD2\"}}",
    "{\"text\":\"返回「进阶饰品」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"381FDE4345973BC2\"}}"
  ],
  "quest.738D2FEEEC0D7797.title": "鲨牙项链",
  "quest.738D2FEEEC0D7797.quest_desc": [
    "穿甲属性增加 5 点。适合在对付有护甲的敌人时换上。",
    "血月期间寻找血腥僵尸或滴滴怪，击败它们有机会获得。出门前先点亮回营路线。",
    "{\"text\":\"展开这件饰品的完整路线\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1C83C750D78AEA53\"}}",
    "{\"text\":\"返回「进阶饰品」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"381FDE4345973BC2\"}}"
  ],
  "quest.72C62BA4C4513481.title": "大自然的恩赐",
  "quest.72C62BA4C4513481.quest_desc": [
    "佩戴后魔力消耗降低 6%。连续用宝石法杖攻击时，每管魔力可以撑得更久。",
    "在丛林或繁茂洞穴寻找并采下这种植物。可直接佩戴，也可留着制成魔力花。",
    "{\"text\":\"展开这件饰品的完整路线\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"72BEB0858D5B5DCE\"}}",
    "{\"text\":\"相关装备 · 魔力花\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7B370C256A30CD5E\"}}",
    "{\"text\":\"返回「进阶饰品」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"381FDE4345973BC2\"}}"
  ],
  "quest.7B370C256A30CD5E.title": "魔力花",
  "quest.7B370C256A30CD5E.quest_desc": [
    "佩戴后魔力消耗降低 8%，需要补充魔力时会自动使用随身的魔力药水。",
    "在哥布林工匠出售的工匠作坊里，合并 1 个大自然的恩赐和 1 瓶魔力药水。炼药桌以 1 个发光蘑菇和 2 瓶弱效魔力药水可制成所需药水。",
    "{\"text\":\"展开这件饰品的完整路线\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"48144649D7C6093F\"}}",
    "{\"text\":\"相关装备 · 大自然的恩赐\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"72C62BA4C4513481\"}}",
    "{\"text\":\"返回「进阶饰品」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"381FDE4345973BC2\"}}"
  ],
  "quest.1BDC6C3FD28BBFCD.title": "起手武器",
  "quest.1BDC6C3FD28BBFCD.quest_desc": [
    "练习铜阔剑、铁弓、紫晶法杖中的一门即可接上序章。噬星之刃能从开局带到后期，剑谱可随时查看。",
    "{\"text\":\"铜阔剑\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0110E6E4E3976E2C\"}}",
    "{\"text\":\"铁弓\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"04D1B369E3B2319C\"}}",
    "{\"text\":\"紫晶法杖\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5C66D939EC5F1860\"}}",
    "{\"text\":\"噬星之刃\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7382B7F69F9F401E\"}}",
    "{\"text\":\"返回装备目录\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"684C355CAD5A8963\"}}"
  ],
  "quest.0110E6E4E3976E2C.title": "铜阔剑",
  "quest.0110E6E4E3976E2C.quest_desc": [
    "近战 · 基础攻击伤害 5，攻击速度 1.6。对付跳起的史莱姆，先横移，等它落地再出剑。",
    "制作 · 在普通工作台从上到下放铜锭、铜锭、木棍。序章首趟下矿的铜锭奖励就够用。",
    "{\"text\":\"返回「起手武器」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1BDC6C3FD28BBFCD\"}}"
  ],
  "quest.04D1B369E3B2319C.title": "铁弓",
  "quest.04D1B369E3B2319C.quest_desc": [
    "远程 · 弓的基础伤害为 3.5，耐久 896。拉弓蓄力、松开发射，带上箭，在平台上边退边打。",
    "制作 · 普通工作台用 3 铁锭和 3 根线。铁锭摆成弓背，线竖排作弦。序章的投点任务会给线和箭。",
    "{\"text\":\"返回「起手武器」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1BDC6C3FD28BBFCD\"}}"
  ],
  "quest.5C66D939EC5F1860.title": "紫晶法杖",
  "quest.5C66D939EC5F1860.quest_desc": [
    "魔法 · 发射直行的宝石弹。基础伤害 13，每发耗 5 魔力，基础施法间隔 13 刻（约 0.65 秒）。",
    "制作 · 在重型工作台用 10 铜锭和 5 紫水晶碎片制作。重型工作台用两个工作台上下夹一个铁砧或铅砧合成。",
    "备战 · 紫水晶晶洞能找到碎片。夜间收集 5 颗坠落之星，可合成一颗魔力水晶来提高魔力上限。",
    "{\"text\":\"相关装备 · 大自然的恩赐\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"72C62BA4C4513481\"}}",
    "{\"text\":\"返回「起手武器」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1BDC6C3FD28BBFCD\"}}"
  ],
  "quest.7382B7F69F9F401E.title": "噬星之刃",
  "quest.7382B7F69F9F401E.quest_desc": [
    "成长 · 在新集镇醒来就能拿到。标准路线累计 50 成长点升到初醒，150 点升到灵锋。",
    "用法 · 二阶主手右键发出剑气，四阶潜行右键释放范围爆发。按 G 或输入 /bladefolio 翻看各阶能力、成长点和首领战果。",
    "{\"text\":\"返回「起手武器」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1BDC6C3FD28BBFCD\"}}"
  ],
  "quest.46BAC8D6E3A42B63.title": "护甲与套装",
  "quest.46BAC8D6E3A42B63.quest_desc": [
    "史莱姆王前先看铜甲。血肉首领战后，再比较钴甲的三种头部和钯金甲的回复效果。",
    "{\"text\":\"查所有护甲部件与分级\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6F67D3AF2352EE0B\"}}",
    "{\"text\":\"铜盔甲\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"06EB25A4145F5400\"}}",
    "{\"text\":\"钴盔甲\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6E55C91A5A1CC598\"}}",
    "{\"text\":\"钯金盔甲\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3EECD32B70AE0A84\"}}",
    "{\"text\":\"返回装备目录\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"684C355CAD5A8963\"}}"
  ],
  "quest.06EB25A4145F5400.title": "铜盔甲",
  "quest.06EB25A4145F5400.quest_desc": [
    "开荒 · 四件穿齐额外获得 1 点护甲。饰品和盔甲各占自己的槽位，穿齐铜甲也能戴云朵瓶。",
    "制作 · 普通工作台做头盔、胸甲、护腿、靴子，分别用 5、8、7、4 铜锭，共 24 锭。打算练铜阔剑的话，多留 2 锭。",
    "{\"text\":\"查看胸甲护甲值与单件配方\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0F4CBFF598E56FDA\"}}",
    "{\"text\":\"返回「护甲与套装」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"46BAC8D6E3A42B63\"}}"
  ],
  "quest.6E55C91A5A1CC598.title": "钴盔甲",
  "quest.6E55C91A5A1CC598.quest_desc": [
    "困难模式 · 穿钴胸甲、护腿和靴子，按武器选第四件。钴头盔套装提高 15% 近战速度；钴帽套装降低 14% 魔力消耗；钴面具套装有 20% 几率省下弹药。",
    "制作 · 击败血肉首领后，用神锤敲祭坛显矿。采得粗钴后在地狱熔炉熔锭；重型工作台做头、胸、腿、靴分别用 10、20、9、6 锭，共 45 锭。",
    "{\"text\":\"查看胸甲护甲值与单件配方\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3AC10C1A830EA275\"}}",
    "{\"text\":\"返回「护甲与套装」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"46BAC8D6E3A42B63\"}}"
  ],
  "quest.3EECD32B70AE0A84.title": "钯金盔甲",
  "quest.3EECD32B70AE0A84.quest_desc": [
    "困难模式 · 穿齐四件后，攻击敌人会提高生命再生速度。三种头部均可组成套装；其中钯金头饰还能增加 60 最大魔力。",
    "制作 · 用神锤敲祭坛显出钯金矿，粗钯金在地狱熔炉熔锭。重型工作台做头、胸、腿、靴分别用 12、24、10、8 锭，共 54 锭。",
    "{\"text\":\"查看胸甲护甲值与单件配方\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5BF1BDB6C7BFAEA2\"}}",
    "{\"text\":\"返回「护甲与套装」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"46BAC8D6E3A42B63\"}}"
  ],
  "quest.36C3A881016E5E96.quest_subtitle": "备好两处工位，再选一种接法试车",
  "quest.09E7B4F0FD881555.title": "试车 · 借齿轮变速",
  "quest.09E7B4F0FD881555.quest_desc": [
    "把大、小齿轮装在平行轴上，让它们沿对角咬合。转动大轮一侧的曲柄，观察小轮提速。这套接法以后能用来带搅拌器。"
  ],
  "quest.242E1BEFBFEA54C9.title": "试车 · 把货送到另一头",
  "quest.242E1BEFBFEA54C9.quest_desc": [
    "放两根平行的传动杆，用传送带依次右键两端连接。手摇一侧，放一块圆石试试去向。这条短带以后能给压机送料。"
  ],
  "quest.04E0645E6BC170B0.quest_subtitle": "变速或送件，任选一项试车",
  "chapter.5A0FF97AED39E75E.chapter_subtitle": [
    "镇里给了你一张床。带上旧剑，去看看通往边境的路。"
  ],
  "quest.69B3711BF25E107B.quest_subtitle": "边境取样与家中供能，可分头开工",
  "quest.7A22062328908A03.quest_subtitle": "读数、实拍任选一项，再修同一座工坊的三处接口",
  "quest.639520F140798DD7.title": "送料方案 · 侧面出库",
  "quest.639520F140798DD7.quest_desc": [
    "原料库和搅拌间在同一层？用干海带和安山合金做安山漏斗，贴在原料桶侧面，下面接传送带或置物台。把纤维放进桶，看着漏斗实际送出一份。",
    "两种送料方式任选一种。把试送的纤维取回，连同其余原料一起送进工作盆。"
  ],
  "quest.75D5D64B85ED67C5.title": "送料方案 · 从楼上投料",
  "quest.75D5D64B85ED67C5.quest_desc": [
    "原料库在压机上方？另备 2 张铁板和 1 个铁锭做溜槽。上接原料桶，下接收料箱，投入一份纤维，看它落进下层。两种送料方式任选一种。"
  ],
  "chapter.6BFCB3A5A742DFD0.chapter_subtitle": [
    "边境的木头能做成胶。先让机器吃进原料、交出第一批成品，再去把旧工坊的轴接回来。"
  ],
  "quest.1697E0EFFE71246B.quest_subtitle": "工程、奥术、远征三路任选两路",
  "quest.7FB7517299ACEB24.quest_subtitle": "两类遗址与一场自选讨伐",
  "quest.5FA8F40EDEF0CEE4.title": "档案室 · 给书架接一盏灯",
  "quest.5FA8F40EDEF0CEE4.quest_desc": [
    "摆一个雕纹书架，让红石比较器的输入端紧贴书架、输出端朝外。装入或取出不同格子的书，比较器强度会跟着变化。可在输出端接红石灯当借阅提示。"
  ],
  "quest.0A9DB7C97A0098E0.title": "档案室 · 机械臂接班",
  "quest.0A9DB7C97A0098E0.quest_desc": [
    "带上工程调查发给你的机械臂。用置物台作取件点、漏斗作交件点，手持机械臂标好输入和输出，再放下接轴供能。让它搬过一件样品。"
  ],
  "chapter.08D219867E4DF589.chapter_subtitle": [
    "机械、术式和遗址各留下一条线索。带回两份完整的调查，合写一册档案。"
  ],
  "quest.2B08699FB66C78B4.quest_subtitle": "从工坊带走工具，让厨房同时开火",
  "quest.01CBB2DD4D43F373.quest_subtitle": "两路物资在压机下汇合",
  "quest.6A44FF99927AF1BD.quest_subtitle": "世界转折 · 血肉墙、血肉山任选一战",
  "quest.47E563F85E3DF8A9.title": "拾回熔岩边的玩偶",
  "quest.47E563F85E3DF8A9.quest_desc": [
    "看准巫毒恶魔脚下的地面再交手，把掉落的向导巫毒玩偶收进背包。领走三盏灯笼，正好够替工兵标一条退路。"
  ],
  "quest.60F201F11C0C8BC9.title": "留给后队的一餐",
  "quest.60F201F11C0C8BC9.quest_desc": [
    "沿灯走过、在火里试过，这条路才好交给下一班。再封一份行军餐，在任务书中提交给后队。",
    "领到的两只末影箱可一只留在工坊、一只带到前线。同一个人的两只箱子相通，赶路时能随手换装备。"
  ],
  "quest.60F201F11C0C8BC9.quest_subtitle": "双线委托 · 提交 1 份热封行军餐",
  "quest.70B98B2219093652.quest_subtitle": "战后归档 · 困难模式开启",
  "chapter.759CB26DEA732B94.chapter_subtitle": [
    "出发时让厨房备餐，回程时让新矿入炉。迎战血肉首领前，先给队伍留一条退路。"
  ],
  "quest.6BEB2BDDDE4B91BF.quest_subtitle": "同一副夹模，矿班铺轨或护卫点灯",
  "quest.7E82D9E88152A714.quest_subtitle": "带两份热封行军餐去领下一张图",
  "quest.190E463BF2347039.title": "矿班联勤 · 第一趟运矿车",
  "quest.190E463BF2347039.quest_desc": [
    "矿工留下铁轨，护卫清过沿途的敌人。备一辆运输矿车（箱子加矿车），再用可乘坐的普通矿车累计行驶 32 格，亲自试一趟线路。",
    "领到的动力铁轨和红石块可以铺进坡道，把满载的车送回熔炉。"
  ],
  "quest.190E463BF2347039.quest_subtitle": "双线委托 · 运货有车，线路试过",
  "chapter.2D5047AC1452BE5B.chapter_subtitle": [
    "第一炉锭给矿班做工具，还是给护卫打甲？锯边剩下的料也别扔，两班都等着一副夹模。"
  ],
  "quest.2A5C04757DCBFF09.quest_subtitle": "单地取证，或双地踏勘",
  "quest.3E5955E508399D8A.quest_subtitle": "墓穴讨伐 · 战果可代替勘察凭据",
  "quest.093F5AD1EFBF4A19.quest_subtitle": "府邸讨伐 · 战果可代替勘察凭据",
  "quest.4C762122353F6EE4.title": "双地踏勘 · 给后来者挂一张图",
  "quest.4C762122353F6EE4.quest_desc": [
    "两处遗址都走一遍。先在档案台绘一张归档图，把它挂进展示框；第二章已挂过图的也算。若展出的正是这趟绘的遗址图，一张图就够交差。",
    "领回磁石和指南针。归档图标的是遗址，下次给补给站埋一块磁石，针就可以专指你选的站口。"
  ],
  "quest.4C762122353F6EE4.quest_subtitle": "联合委托 · 调查两个遗址，沿用档案室的地图展出记录",
  "quest.33B054D584DD1602.quest_subtitle": "取到一种凭据后，把归档图带回前线",
  "chapter.3ABD0124FB8AEDA1.chapter_subtitle": [
    "去墓穴或府邸带回手记、照片或战果。愿意跑两地的测绘员，还可用展图交差。"
  ],
  "quest.50A0C915D6A748F0.quest_subtitle": "沿归档图重访遗址，行粮、救援、货运任选两项",
  "quest.77CBB65AB509D459.quest_subtitle": "三单择二 · 向营地签领一包储备，再在前线拆用",
  "quest.4DE233CFEF449102.quest_subtitle": "自选赏金 · 沿用第五章首领战果",
  "quest.012D0526E5B8ACCB.title": "前后方联勤 · 随身库房",
  "quest.012D0526E5B8ACCB.quest_desc": [
    "第三章后队的两只末影箱派上用场了。一只放工坊，一只放营地，把自己常换的工具存进去，两头都能取。",
    "累计打开末影箱两次即可交差。营地木桶照常用来盘点全队的货。"
  ],
  "quest.012D0526E5B8ACCB.quest_subtitle": "下界后队委托的后续 · 查两次个人库存",
  "quest.3290EE38B2FFB48F.title": "测绘联勤 · 标出站口",
  "quest.3290EE38B2FFB48F.quest_desc": [
    "把双地踏勘领到的磁石安在站口，手持普通指南针对它右键。留一枚普通指南针盘货，把定过向的那枚带出门。",
    "在同一维度，磁石指针会带你回到埋石的位置。已经学会校准磁石指南针的测绘员可以沿用原有进度。"
  ],
  "quest.3290EE38B2FFB48F.quest_subtitle": "双地踏勘的后续 · 给返程留一枚磁石指针",
  "chapter.2B9783ABBA2533ED.chapter_subtitle": [
    "在地图指向的地方立站。行粮、救援、货运办成两项，再拿一张领用单去桶边交班。"
  ],
  "chapter_group.529379A5653E5792.title": "远征主线",
  "chapter_group.1AD67844174FBD9C.title": "随身手册",
  "chapter.30BF0ECE49E4C122.title": "旅人手记",
  "chapter.30BF0ECE49E4C122.chapter_subtitle": [
    "翻到正在走的那一段。每完成一章，会留下一页手记。"
  ],
  "quest.342CE32A04725ED3.title": "这一路怎样走",
  "quest.342CE32A04725ED3.quest_subtitle": "行程索引 · 章末添页",
  "quest.342CE32A04725ED3.quest_desc": [
    "先在小镇站稳脚，再到边境找那座停转的工坊。下面的地名能翻到对应章节；归来时，再看手记里添了什么。",
    "{\"text\":\"序章 · 从小屋出发\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4B61DD93ABC703EA\"}}",
    "{\"text\":\"第一章 · 重启第一座工坊\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"69B3711BF25E107B\"}}",
    "{\"text\":\"第二章 · 遗产调查\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1697E0EFFE71246B\"}}",
    "{\"text\":\"第三章 · 世界转折\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2B08699FB66C78B4\"}}",
    "{\"text\":\"第四章 · 困难模式整备\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6BEB2BDDDE4B91BF\"}}",
    "{\"text\":\"第五章 · 遗址远征\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2A5C04757DCBFF09\"}}",
    "{\"text\":\"第六章 · 前线补给站\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"50A0C915D6A748F0\"}}",
    "{\"text\":\"查首领与世界变化\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"725098F959D2BC77\"}}",
    "{\"text\":\"查装备与饰品\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"684C355CAD5A8963\"}}"
  ],
  "quest.20D18D2D7DDD7624.title": "第一次认得回家的路",
  "quest.20D18D2D7DDD7624.quest_subtitle": "序章 · 从小屋出发 · 归来记",
  "quest.20D18D2D7DDD7624.quest_desc": [
    "我想不起自己从哪儿来，却已经认得回镇的路了。打倒史莱姆王以后，原先走不通的边境也能踏进去了。下次回镇，带一捆那边的木头。",
    "{\"text\":\"翻回本章成果\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"259C64DF4D981F3C\"}}",
    "{\"text\":\"下一站 · 重启第一座工坊\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"69B3711BF25E107B\"}}"
  ],
  "quest.22B7534252384322.title": "维修簿里的箭头",
  "quest.22B7534252384322.quest_subtitle": "第一章 · 重启第一座工坊 · 归来记",
  "quest.22B7534252384322.quest_desc": [
    "在换向节点旁画一个箭头，在旁边写上八转。下一个来修工坊的人看到这两笔，就知道该从哪根轴开始查。原来一门手艺能这样留下来。",
    "{\"text\":\"翻回本章成果\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4FB59596BCAF8408\"}}",
    "{\"text\":\"下一站 · 遗产调查\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1697E0EFFE71246B\"}}"
  ],
  "quest.491818F96E80FB22.title": "翻开第一册档案",
  "quest.491818F96E80FB22.quest_subtitle": "第二章 · 遗产调查 · 归来记",
  "quest.491818F96E80FB22.quest_desc": [
    "我翻开档案，本想找一个熟悉的名字。读到的却是能重新接好的机器、还可以施放的术式。黄金时代的人曾用这两种本领一同求知。要找回他们的历史，也许可以先学会他们做过的事。",
    "{\"text\":\"翻回本章成果\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"76FC61C7DB7BD176\"}}",
    "{\"text\":\"下一站 · 世界转折\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2B08699FB66C78B4\"}}"
  ],
  "quest.0A08588D8827B1D6.title": "神锤响过以后",
  "quest.0A08588D8827B1D6.quest_subtitle": "第三章 · 世界转折 · 归来记",
  "quest.0A08588D8827B1D6.quest_desc": [
    "血肉首领倒下、地貌变化、神锤敲响祭坛。我把三件事分行记下，最后一行夹了一张新矿的炉料单。那些金属原本藏在哪里？等下一趟带回证据，再往下写。",
    "{\"text\":\"翻回本章成果\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"24BA016E81A9BDB9\"}}",
    "{\"text\":\"下一站 · 困难模式整备\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6BEB2BDDDE4B91BF\"}}"
  ],
  "quest.740C87BDE3458FD6.title": "谁来试这批新料",
  "quest.740C87BDE3458FD6.quest_subtitle": "第四章 · 困难模式整备 · 归来记",
  "quest.740C87BDE3458FD6.quest_desc": [
    "工单背面有两个草图。一张画着坡底的轨头，一张画着岗亭顶上的灯钩。我把模留在机械手里，给下一班画了第三张图，告诉他们从哪里换坯。",
    "{\"text\":\"翻回本章成果\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7E82D9E88152A714\"}}",
    "{\"text\":\"下一站 · 遗址远征\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2A5C04757DCBFF09\"}}"
  ],
  "quest.7CD0AE54FACE540B.title": "地图给谁看",
  "quest.7CD0AE54FACE540B.quest_subtitle": "第五章 · 遗址远征 · 归来记",
  "quest.7CD0AE54FACE540B.quest_desc": [
    "来时我只想找到入口。把归档地图摊开，才发觉自己还得回答另一件事：没来过这里的人，怎样也能找到？下一趟就沿这张图走，在能落脚的地方点一堆火。",
    "{\"text\":\"翻回本章成果\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"33B054D584DD1602\"}}",
    "{\"text\":\"下一站 · 前线补给站\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"50A0C915D6A748F0\"}}"
  ],
  "quest.6CBF4D2D6EFF6D3B.title": "桶边的火",
  "quest.6CBF4D2D6EFF6D3B.quest_subtitle": "第六章 · 前线补给站 · 归来记",
  "quest.6CBF4D2D6EFF6D3B.quest_desc": [
    "离开的时候，我把营火留在木桶旁。晚到的人可以在这里吃一顿饭，脚手架也有地方找。这本手记第一页，是别人留给我的一张床。到这里，我也给后来的人留了点东西。",
    "{\"text\":\"翻回本章成果\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"77CBB65AB509D459\"}}",
    "{\"text\":\"回站接一份扩建委托\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"48F94E85B08F7E71\"}}"
  ],
  "quest.7E2C4B05D19FA504.title": "两块木样",
  "quest.7E2C4B05D19FA504.quest_subtitle": "夹页 · 边境采样",
  "quest.7E2C4B05D19FA504.quest_desc": [
    "乌木和暗影木并排时很好认。可它们都能磨出纤维，拌成同一种胶。要是只把成品带回去，谁还分得出它来自哪片林子？留一块原木，把采样地写在旁边。",
    "{\"text\":\"翻到两地采样\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5B7CF06798316864\"}}"
  ],
  "quest.7EE73780E77D801B.title": "镜头外的一行字",
  "quest.7EE73780E77D801B.quest_subtitle": "夹页 · 两种现场记录",
  "quest.7EE73780E77D801B.quest_desc": [
    "旧人曾用精密的仪器望向群星。我只拍了一面墙，回来却分不清暗下来的是纹样，还是提灯挪开了一步。把站立的位置也写下来，下次请同伴从那里再看一眼。",
    "{\"text\":\"再去现场记一笔\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"506301D381EF9278\"}}",
    "{\"text\":\"把记录绘成回访图\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"33B054D584DD1602\"}}"
  ],
  "chapter.09226FAD78F877E5.title": "首领战册",
  "chapter.09226FAD78F877E5.chapter_subtitle": [
    "先找这场仗的用处，再准备召唤物和退路。"
  ],
  "quest.725098F959D2BC77.title": "先看这场仗的用处",
  "quest.725098F959D2BC77.quest_subtitle": "世界门槛与自由讨伐",
  "quest.725098F959D2BC77.quest_desc": [
    "史莱姆王管边境，血肉首领管困难模式。想备战这两场，翻「世界转折」；想挑选一份适合当前配装的悬赏，翻后两册。",
    "{\"text\":\"世界转折\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0E3DE863E601BAF1\"}}",
    "{\"text\":\"调查委托\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6DC7AAD8E935A5D8\"}}",
    "{\"text\":\"遗址悬赏\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6A397FA1121CD9FD\"}}",
    "{\"text\":\"查战前装备与饰品\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"684C355CAD5A8963\"}}"
  ],
  "quest.0E3DE863E601BAF1.title": "世界转折",
  "quest.0E3DE863E601BAF1.quest_subtitle": "首领战册 · 选一位对手",
  "quest.0E3DE863E601BAF1.quest_desc": [
    "打赢后，整个存档都会看到变化。",
    "{\"text\":\"史莱姆王\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"35B312A8CFC0CEFF\"}}",
    "{\"text\":\"血肉墙／血肉山\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"29A906D9451C6C57\"}}",
    "{\"text\":\"回到战册目录\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"725098F959D2BC77\"}}"
  ],
  "quest.35B312A8CFC0CEFF.title": "史莱姆王",
  "quest.35B312A8CFC0CEFF.quest_subtitle": "序章 · 打开边境",
  "quest.35B312A8CFC0CEFF.quest_desc": [
    "工作台中央放金冠或铂金冠，周围摆 8 个凝胶。带上做好的史莱姆皇冠，到有横移空间的平地使用。",
    "它收拢身体时先看落点。用跑鞋横移或用云朵瓶越过它，等它落稳再还击。击败本体后，全世界通往猩红和腐化的路开放；第一批边境木就是修工坊的原料。",
    "{\"text\":\"翻到对应任务\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"441D1DEFF4C0B58E\"}}",
    "{\"text\":\"挑一件开荒饰品\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"45935826E246E542\"}}",
    "{\"text\":\"回到「世界转折」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0E3DE863E601BAF1\"}}"
  ],
  "quest.29A906D9451C6C57.title": "血肉墙／血肉山",
  "quest.29A906D9451C6C57.quest_subtitle": "第三章 · 任一形态开启困难模式",
  "quest.29A906D9451C6C57.quest_desc": [
    "在下界先找一段可以持续移动的路线。手持向导巫毒玩偶长按使用，核对提示里的形态，再把玩偶丢入下界岩浆。",
    "两种形态任选一场。打赢后世界进入困难模式，地形开始转化；带神锤敲祭坛，去找钴矿或钯金矿。档案台能查到战果和转化进度。",
    "{\"text\":\"翻到对应任务\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6A44FF99927AF1BD\"}}",
    "{\"text\":\"回工坊准备行军餐\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"01CBB2DD4D43F373\"}}",
    "{\"text\":\"回到「世界转折」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0E3DE863E601BAF1\"}}"
  ],
  "quest.6DC7AAD8E935A5D8.title": "调查委托",
  "quest.6DC7AAD8E935A5D8.quest_subtitle": "首领战册 · 选一位对手",
  "quest.6DC7AAD8E935A5D8.quest_desc": [
    "第二章走远征路线时，六位对手任选一位，再走访两类遗迹。也可以用工程和奥术两线完成调查。",
    "{\"text\":\"钢铁守护者\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"70C86B17DE824438\"}}",
    "{\"text\":\"霜冻巨兽\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"703345080C40CC87\"}}",
    "{\"text\":\"克苏鲁之眼\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7C38FB547B8946B5\"}}",
    "{\"text\":\"世界吞噬怪\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7B536B4679847DC8\"}}",
    "{\"text\":\"克苏鲁之脑\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7733095C1A6E0486\"}}",
    "{\"text\":\"骷髅领主\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"78A08FDC49D73D4E\"}}",
    "{\"text\":\"回到战册目录\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"725098F959D2BC77\"}}"
  ],
  "quest.70C86B17DE824438.title": "钢铁守护者",
  "quest.70C86B17DE824438.quest_subtitle": "第一章支线 · 战果可用于远征",
  "quest.70C86B17DE824438.quest_desc": [
    "用探险者指南针搜 mowziesmobs:wrought_chamber，进入地下石室。给巨斧留出空间，等重劈落空、斧头陷进地面，再绕到它背后出手。",
    "赢下第一章「沉睡的铁甲」后，第二章可沿用战果。它的千锻巨斧可右键横扫，也可潜行右键震地。",
    "{\"text\":\"翻到对应任务\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"01646532D249D22F\"}}",
    "{\"text\":\"回到「调查委托」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6DC7AAD8E935A5D8\"}}"
  ],
  "quest.703345080C40CC87.title": "霜冻巨兽",
  "quest.703345080C40CC87.quest_subtitle": "第二章 · 雪地远征",
  "quest.703345080C40CC87.quest_desc": [
    "到雪地寻找沉睡的巨兽；探险者指南针可搜 mowziesmobs:frostmaw_spawn。近身攻击会惊醒它，先留出绕到侧面的空间。",
    "打倒本体可交一份远征战果。它仍握着冰霜结晶时由玩家击败，才有结晶可取；持晶长按右键能吹出冰霜旋风。",
    "{\"text\":\"翻到对应任务\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2A804883BB0B2318\"}}",
    "{\"text\":\"接单 · 雪地结晶回收\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"379A98862E2970D5\"}}",
    "{\"text\":\"回到「调查委托」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6DC7AAD8E935A5D8\"}}"
  ],
  "quest.7C38FB547B8946B5.title": "克苏鲁之眼",
  "quest.7C38FB547B8946B5.quest_subtitle": "第二章 · 夜间邀战",
  "quest.7C38FB547B8946B5.quest_desc": [
    "在祭坛用 6 个晶状体制作可疑眼球。选夜晚到开阔处使用，留出横向闪避冲刺的空间。",
    "想走远征线又不愿深入墓室时，可以挑这一场；另两类遗迹勘察仍需实地完成。",
    "{\"text\":\"翻到对应任务\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2A804883BB0B2318\"}}",
    "{\"text\":\"回到「调查委托」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6DC7AAD8E935A5D8\"}}"
  ],
  "quest.7B536B4679847DC8.title": "世界吞噬怪",
  "quest.7B536B4679847DC8.quest_subtitle": "第二章 · 腐化调查",
  "quest.7B536B4679847DC8.quest_desc": [
    "在祭坛以 30 份魔粉和 15 份腐肉制成蠕虫诱饵，带到腐化之地使用。魔粉可以用当地的魔菇研制。",
    "把战场留在能看清地面的位置。它分节出土时先避开头部，整场战斗结束后再回档案台整理战果。",
    "{\"text\":\"翻到对应任务\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2A804883BB0B2318\"}}",
    "{\"text\":\"回到「调查委托」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6DC7AAD8E935A5D8\"}}"
  ],
  "quest.7733095C1A6E0486.title": "克苏鲁之脑",
  "quest.7733095C1A6E0486.quest_subtitle": "第二章 · 猩红调查",
  "quest.7733095C1A6E0486.quest_desc": [
    "在祭坛用 30 份毒粉、15 个椎骨制作血腥脊椎，前往猩红之地使用。毒粉可由当地的毒蘑菇制成。",
    "先腾出能反复转身的战场，处理围上来的随从，再追本体。选这一位也能交同一份远征委托。",
    "{\"text\":\"翻到对应任务\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2A804883BB0B2318\"}}",
    "{\"text\":\"回到「调查委托」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6DC7AAD8E935A5D8\"}}"
  ],
  "quest.78A08FDC49D73D4E.title": "骷髅领主",
  "quest.78A08FDC49D73D4E.quest_subtitle": "第二章 · 大坟墓调查",
  "quest.78A08FDC49D73D4E.quest_desc": [
    "用探险者指南针搜 goety:crypt。进入大坟墓，先清开来路，再查看墓穴瓮；开瓮时可能遭遇领主。",
    "目标是骷髅领主本体，已有诡厄对应击败成就也可登记。若补给不足，可以先撤回，另选同阶段对手。",
    "{\"text\":\"翻到对应任务\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2A804883BB0B2318\"}}",
    "{\"text\":\"回到「调查委托」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6DC7AAD8E935A5D8\"}}"
  ],
  "quest.6A397FA1121CD9FD.title": "遗址悬赏",
  "quest.6A397FA1121CD9FD.quest_subtitle": "首领战册 · 选一位对手",
  "quest.6A397FA1121CD9FD.quest_desc": [
    "死者之王和灾厄宰相各算一份现场凭据。也可以记手记、拍照片，或踏勘两地后展出归档图。",
    "{\"text\":\"死者之王\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"45966785EFF70FB9\"}}",
    "{\"text\":\"灾厄宰相\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"69BAF0BABD7CB422\"}}",
    "{\"text\":\"回到战册目录\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"725098F959D2BC77\"}}"
  ],
  "quest.45966785EFF70FB9.title": "死者之王",
  "quest.45966785EFF70FB9.quest_subtitle": "第五章 · 地下墓穴",
  "quest.45966785EFF70FB9.quest_desc": [
    "跟随归途指南针，或搜 irons_spellbooks:catacombs。深入墓室，与沉睡的遗骸互动才会唤醒死者之王。",
    "若只想勘察，可以在惊醒它之前带走现场记录。决定开战时，先把退出内室的路认清。战果可用于第五章制图，也可留给第六章的驻地委托。",
    "{\"text\":\"翻到对应任务\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3E5955E508399D8A\"}}",
    "{\"text\":\"回到「遗址悬赏」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6A397FA1121CD9FD\"}}"
  ],
  "quest.69BAF0BABD7CB422.title": "灾厄宰相",
  "quest.69BAF0BABD7CB422.quest_subtitle": "第五章 · 林地府邸",
  "quest.69BAF0BABD7CB422.quest_desc": [
    "先找到原版林地府邸。工作台从上到下摆黑色染料、魔法布料和不死图腾，做成黑暗卷轴，在府邸内长按使用。",
    "盯住宰相本体，分身倒下时继续观察。本人或仆从的原生讨伐成就都可承接；战果能作第五章的调查凭据。",
    "{\"text\":\"翻到对应任务\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"093F5AD1EFBF4A19\"}}",
    "{\"text\":\"接单 · 让仆从完成最后一击\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"40BC4833A91D03D1\"}}",
    "{\"text\":\"回到「遗址悬赏」\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6A397FA1121CD9FD\"}}"
  ],
  "quest.379A98862E2970D5.title": "雪地悬赏 · 带回冰霜结晶",
  "quest.379A98862E2970D5.quest_desc": [
    "雪地队要带回一件能继续研究的战利品。找到仍握着冰霜结晶的霜冻巨兽，亲自击败它，把结晶带在身上。",
    "结晶留给出队的人，长按使用可吹出冰霜旋风。结账时另领取一双摔落保护靴和雪地铺路用的蓝冰。",
    "{\"text\":\"查找巨兽和持晶条件\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"703345080C40CC87\"}}"
  ],
  "quest.379A98862E2970D5.quest_subtitle": "雪地自选 · 本人击败记录与一枚结晶",
  "quest.40BC4833A91D03D1.title": "府邸悬赏 · 仆从收尾",
  "quest.40BC4833A91D03D1.quest_desc": [
    "把第二章的奥术实践带到府邸。这回由你牵制宰相，留给自己的诡厄仆从完成最后一击。",
    "取得仆从击败宰相的成就可交这份额外战报，领回一个不死图腾和经验瓶。",
    "{\"text\":\"查阅府邸邀战方法\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"69BAF0BABD7CB422\"}}"
  ],
  "quest.40BC4833A91D03D1.quest_subtitle": "奥术自选 · 仆从击败宰相本体",
  "quest.1A6130BA7811B24A.title": "选料 · 用水洗还是用胶压",
  "quest.1A6130BA7811B24A.quest_desc": [
    "湿法：把炉料放在水流后方的鼓风机气流里洗选，不用添胶。干法：炉料加 1 份第一章的共振胶，在压机下的工作盆里压团。",
    "两种方法都得到精炼炉料，钴与钯金各走自己的线路。选工坊里最容易连续供料的一种。"
  ],
  "quest.1A6130BA7811B24A.quest_subtitle": "鼓风洗选或工作盆压团，任选一种",
  "quest.5A6AC6C32B011E4F.title": "熔炼 · 留住整块铸坯",
  "quest.5A6AC6C32B011E4F.quest_desc": [
    "将精炼炉料送进有燃料的地狱熔炉。出炉的是一整块连铸坯，给它留一个出料口，送往水平朝上的动力锯。"
  ],
  "quest.70BEECC308A5979C.title": "开坯 · 金属锭与边料分走两路",
  "quest.70BEECC308A5979C.quest_desc": [
    "把连铸坯交给锯面朝上的动力锯，每坯切出 3 个同种金属锭和 1 片硬质边料。金属锭留给配装，边料留给下一章做夹模。",
    "手工试车可把两种出料都拾起。接了漏斗或传送带，可以在末端取边料补记整条精炼线。"
  ],
  "quest.70BEECC308A5979C.quest_subtitle": "同一炉分出金属锭与工装料",
  "quest.52CA60EB8641FDB7.title": "工装 · 从锯边料到施工夹模",
  "quest.52CA60EB8641FDB7.quest_desc": [
    "取第三章的硬质边料。让机械手加 1 份安山合金，动力锯开槽，注液器浇 250 mB 水，最后用机械压机定型。按此顺序各过一遍。",
    "小工坊可手搬同一件半成品，大工坊可用传送带串起来。成模装进机械手后选一个订单试产，两类订单都能用同一副模。"
  ],
  "quest.52CA60EB8641FDB7.quest_subtitle": "一轮四道工序，夹模可以反复用",
  "quest.6D41DE3990F793C3.title": "矿班首件 · 压轨铺路",
  "quest.6D41DE3990F793C3.quest_desc": [
    "在工作盆用压机把 2 张铁板、1 根木棍压成轨料坯。机械手握施工夹模，在坯上压出 8 段工坊钢轨，模具留在手里。",
    "用这批带工坊标记的钢轨铺下第一段。剩余钢轨可以接进运矿线。"
  ],
  "quest.75F243820EA01204.title": "护卫首件 · 压灯布哨",
  "quest.75F243820EA01204.quest_desc": [
    "工作盆内放 1 张铁板、1 块玻璃板和 2 支普通火把，用压机压成灯座坯。让握着施工夹模的机械手铆合，一坯出 2 盏工坊提灯。",
    "用这批带工坊标记的提灯点亮一处岗哨。以后同一条线也能给前线补灯。"
  ],
  "quest.1C116574FE92217F.title": "货运到站 · 第一张回执",
  "quest.1C116574FE92217F.quest_desc": [
    "把收件蛙港装在营地木桶正上方，接上锁链，打开收件并填地址。让营火一直亮着，给蛙港和桶都留点空位。",
    "在发件端把至少 1 个野外或救援补给包封进写有该地址的纸箱，通过锁链发往营地。收件成功后，主手指南针潜行点桶即可读回执，同伴也能来核对。",
    "从桶里取出外箱，手持它潜行对空气右键，把拆出的补给包存回桶里。愿意常跑这条线的话，领到的第二台打包机可以用来拆箱。"
  ],
  "quest.2EAE55106F9758BD.title": "合单发运 · 同一箱里的两份委托",
  "quest.2EAE55106F9758BD.quest_desc": [
    "厨房和救援队的订单正好同路。在发件库存放入两种补给各至少 1 包，再触发打包机，合装成一只寄往营地的外箱。两只单品箱分开发不会取得合单回执。",
    "到营地持指南针潜行点桶读回执。要让拆箱也能连班，可用过滤漏斗从桶中只抽外箱，送入背靠库存的第二台打包机，让拆出的补给包回到库存。"
  ],
  "quest.2B26B21A518D11B1.title": "夹在炉边的工艺单",
  "quest.2B26B21A518D11B1.quest_subtitle": "车间查阅 · 从六块粗矿到一副夹模",
  "quest.2B26B21A518D11B1.quest_desc": [
    "六块同种粗矿拌成一块炉料。要给镐钻或盔甲攒锭，就把炉料洗过或加胶压实，再进地狱熔炉。锯一块坯，取三锭和一片边料。",
    "边料交给机械手装合金，再锯槽、浇水、压合。把成模留在机械手里，换轨料坯或灯座坯就能转产。只做一单时，可以自己搬半成品。",
    "{\"text\":\"看两种精炼法\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1A6130BA7811B24A\"}}",
    "{\"text\":\"查夹模的工序\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"52CA60EB8641FDB7\"}}",
    "{\"text\":\"矿班的轨料单\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6D41DE3990F793C3\"}}",
    "{\"text\":\"护卫的灯座单\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"75F243820EA01204\"}}"
  ],
  "quest.671B6C089B024E32.title": "工程 · 水从哪儿来",
  "quest.671B6C089B024E32.quest_desc": [
    "两张铜板夹一枚铜锭，做出四根流体管道。用管道和齿轮做机械泵，接上动力让它转起来。用扳手调好泵的方向，将水推往注液器。",
    "管网可以固定在河边，也可以用桶供料。下两格任选一种，整座工坊只需交一份供水记录。"
  ],
  "quest.131AF244F974A9FE.title": "取水方案 · 河岸泵房",
  "quest.131AF244F974A9FE.quest_desc": [
    "把开口管正对水源方块，另一端经泵接注液器或储罐。让系统确实抽到水。留出能补水的水源，下一批就可以连续开工。"
  ],
  "quest.24418B0A0F79F2FE.title": "取水方案 · 厂内倒桶",
  "quest.24418B0A0F79F2FE.quest_desc": [
    "铁栏杆放在铜机壳上方合成分液池。往池面放一桶水，等空桶被送出。给分液池接管，将水泵到注液器，厂房从此不必紧邻河岸。"
  ],
  "quest.0AC95E4E0F16B2A6.title": "工程 · 开阀试灌",
  "quest.0AC95E4E0F16B2A6.quest_desc": [
    "用铜机壳和干海带做注液器，接在泵的出水管上。下方放置物台，放一块泥土，实际注入 500 mB 水得到草方块。也可以直接用下一步的黄铜机壳试灌。"
  ],
  "quest.0E28128EF3B16622.title": "工程委托 · 试装一台调速器",
  "quest.0E28128EF3B16622.quest_desc": [
    "干净的黄铜机壳先在注液器下注入 250 mB 水。把湿润的试装件移到机械手下，给机械手一个精密构件；再交给压机封壳。一遍就能得到工坊试装调速器。",
    "用置物台逐站转移，或把三台机器沿传送带排开都行。拿起成品登记，再把它装回传动轴。"
  ],
  "quest.0667CA7E4B3258D0.title": "工程委托 · 带载调速",
  "quest.0667CA7E4B3258D0.quest_desc": [
    "把调速器接上动力，顶面安一枚竖直的大齿轮，让齿轮轴与调速器的轴交叉。准星对着调速器，用滚轮改变设定，让大齿轮带动输出轴。",
    "可把这段轴接回工作盆，以 32 RPM 带动搅拌器。试车读的是调速器在转、齿轮已接好且改过设定。"
  ],
  "quest.427754DFB7DEB775.title": "工程档案 · 领取已签的记录",
  "quest.427754DFB7DEB775.quest_desc": [
    "世界共用一本工程总档。有同伴签过调速器试车单，或旧版工坊已登记工程调查，就能在这里抄一份记录。刚开工的队伍沿上方两班施工。"
  ],
  "chapter_group.2A358FE51A17E292.title": "护甲图鉴",
  "chapter_group.6D1938960E54F1E0.title": "饰品合成图",
  "quest.6F67D3AF2352EE0B.title": "按护甲值查盔甲",
  "quest.6F67D3AF2352EE0B.quest_desc": [
    "选一档护甲值，再按头、胸、腿、足或动物装备查找。",
    "{\"text\":\"护甲值 0\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"746ACB98916DD302\"}}",
    "{\"text\":\"护甲值 1–2\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6B5565E13A7F9ECE\"}}",
    "{\"text\":\"护甲值 3–4\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"171CA5A5565A993C\"}}",
    "{\"text\":\"护甲值 5–6\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7AA9EC1ECA34F5E3\"}}",
    "{\"text\":\"护甲值 7–8\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2CE8DE2848CF4E7D\"}}",
    "{\"text\":\"护甲值 9–12\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4105CAADD992C086\"}}",
    "{\"text\":\"护甲值 13 及以上\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"018312431844AE4F\"}}",
    "{\"text\":\"返回随身装备手册\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"684C355CAD5A8963\"}}"
  ],
  "quest.052784AEB4F7DBD1.title": "从材料到成品",
  "quest.052784AEB4F7DBD1.quest_desc": [
    "想做一件成品，沿路线向左找材料。点开任一件，也能向右查它可以合成什么。",
    "{\"text\":\"多阶合成路线\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5D277CCE26CF0CD2\"}}",
    "{\"text\":\"小型合成路线\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"143FE113EFFE1A18\"}}",
    "{\"text\":\"独立饰品\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5A57BB020D18DFC1\"}}",
    "{\"text\":\"返回随身装备手册\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"684C355CAD5A8963\"}}"
  ],
  "chapter.746ACB98916DD302.title": "护甲值 0",
  "quest.3ECE3C28BEDD1DBB.title": "从哪一栏找",
  "quest.3ECE3C28BEDD1DBB.quest_desc": [
    "按单件提供的护甲值排册。套装、附魔和饰品加成可以在穿戴后改变面板。",
    "{\"text\":\"头部 · 18 件\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2FB9E1C5B563D46D\"}}",
    "{\"text\":\"胸部 · 11 件\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3CB4FE1D3BFDCC1E\"}}",
    "{\"text\":\"腿部 · 8 件\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"00D1879BE8730E21\"}}",
    "{\"text\":\"足部 · 8 件\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1FAFB6960D38179E\"}}"
  ],
